---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { href } from "../data/site";
import { profile } from "../data/profile";

// Experience timeline (most recent first via `order`)
const rawExperience = (await getCollection("experience")).sort(
  (a, b) => b.data.order - a.data.order,
);
const timeline = await Promise.all(
  rawExperience.map(async (entry) => ({
    id: entry.id,
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
);

const skillGroups = Object.entries(profile.skills);
---

<BaseLayout title="About" description="Who João Guedes is — backend engineer, ex-security, homelab tinkerer and motorcyclist in Porto.">
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-20">
    <p class="eyebrow">The person behind the commits</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">About</h1>

    <!-- Hero: portrait + intro -->
    <div class="mt-10 grid gap-8 md:grid-cols-[1fr_17rem] md:items-start">
      <div class="prose order-2 md:order-1">
        <p>
          Hey — I'm João. I'm a backend software engineer at <strong>Uphold</strong>, based in
          Porto, Portugal. I spend my days on the parts of software people never think about:
          the services, the data flows, the integrations, the things that are only noticed when
          they break. My goal is that they don't.
        </p>
        <p>
          I came into product engineering from <strong>cybersecurity</strong>, and that lens
          never really leaves you. I think about trust boundaries, failure modes, and the
          blast radius of a change more than is strictly necessary — which, it turns out, is a
          useful habit when you're building systems that handle other people's money and data.
        </p>
        <p>
          Outside work I run a <strong>homelab</strong> that's been quietly humming since 2022 —
          a place to break things safely, self-host what I can, and learn the stuff that
          doesn't fit into a workday. When I'm not near a keyboard, I'm usually on a
          <strong>motorcycle</strong> chasing a good road, or being thoroughly out-prioritized
          by my <strong>dogs</strong>.
        </p>
        <p>
          This site is where I keep it all together: the
          <a href={href("/projects")}>projects</a> I've built, the
          <a href={href("/snippets")}>snippets</a> I don't want to google again, the
          <a href={href("/blog")}>longer pieces</a> when something's worth writing down, and
          the <a href={href("/certifications")}>certifications</a> I've picked up along the way.
        </p>
      </div>

      <figure class="order-1 mx-auto w-full max-w-[15rem] md:order-2 md:mx-0 md:max-w-none">
        <img
          src={href("/guedes_profile.png")}
          alt="Portrait of João Guedes"
          width="503"
          height="671"
          decoding="async"
          class="w-full rounded-2xl border border-base-300 object-cover shadow-sm"
        />
        <figcaption class="mt-3 text-center text-xs text-base-content/45 md:text-left">
          {profile.tagline}
        </figcaption>
      </figure>
    </div>

    <!-- What I work with -->
    <div class="mt-14 flex items-center gap-4">
      <span class="eyebrow">What I work with</span>
      <span class="h-px flex-1 bg-base-300"></span>
    </div>

    <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
      {
        skillGroups.map(([group, list]) => (
          <div>
            <p class="eyebrow mb-2.5">{group}</p>
            <ul class="flex flex-wrap gap-1.5">
              {list.map((s) => (
                <li class="rounded-full border border-base-300 bg-base-100 px-3 py-1 text-xs text-base-content/80">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      profile.softSkills.length > 0 && (
        <div class="mt-8">
          <p class="eyebrow mb-2.5">How I work</p>
          <ul class="flex flex-wrap gap-1.5">
            {profile.softSkills.map((s) => (
              <li class="rounded-full border border-base-300 bg-base-100 px-3 py-1 text-xs text-base-content/80">{s}</li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Beyond the code -->
    {
      profile.interests.length > 0 && (
        <>
          <div class="mt-14 flex items-center gap-4">
            <span class="eyebrow">Beyond the code</span>
            <span class="h-px flex-1 bg-base-300" />
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {profile.interests.map((it) => (
              <div class="flex items-start gap-3.5 rounded-box border border-base-300 bg-base-100 p-5">
                <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-field border border-base-300 bg-base-200 text-primary">
                  <Icon name={it.icon} size={18} />
                </span>
                <div class="min-w-0">
                  <p class="font-display text-base leading-snug">{it.label}</p>
                  {it.note && <p class="mt-0.5 text-sm leading-relaxed text-base-content/60">{it.note}</p>}
                </div>
              </div>
            ))}
          </div>
        </>
      )
    }

    <!-- The road so far -->
    <div class="mt-14 flex items-center gap-4">
      <span class="eyebrow">The road so far</span>
      <span class="h-px flex-1 bg-base-300"></span>
    </div>

    <section aria-label="Experience timeline" class="mt-8">
      <h2 class="text-2xl">Where I've been</h2>
      {
        timeline.length > 0 ? (
          <ol class="mt-8 space-y-8 border-l border-base-300 pl-6">
            {timeline.map((item) => (
              <li class="relative">
                <span class="dot absolute -left-[1.65rem] top-2" />
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-display text-lg">
                    <a href={href(`/experience/${item.id}`)} class="transition-colors hover:text-primary">
                      {item.data.role} <span class="text-primary">· {item.data.company}</span>
                    </a>
                  </h3>
                  <span class="text-xs text-base-content/50">
                    {item.data.start} — {item.data.end}
                  </span>
                </div>
                {item.data.location && (
                  <p class="text-xs text-base-content/45">{item.data.location}</p>
                )}
                <div class="prose prose-sm mt-2 max-w-none">
                  <item.Content />
                </div>
                {item.data.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {item.data.tags.map((t) => (
                      <li class="rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">
                        {t}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <p class="mt-6 text-base-content/60">Timeline coming soon.</p>
        )
      }
      <p class="mt-8 text-sm text-base-content/60">
        Open any role for the details and the projects that came with it —
        <a href={href("/experience")} class="text-primary underline underline-offset-4">all experience →</a>
        &nbsp;·&nbsp; or the condensed
        <a href={href("/resume")} class="text-primary underline underline-offset-4">résumé →</a>
      </p>
    </section>
  </section>
</BaseLayout>
