---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemIcon from "../components/SystemIcon.astro";
import { href } from "../data/site";
import { profile } from "../data/profile";

// Experience timeline (most recent first via `order`)
const rawExperience = (await getCollection("experience")).sort(
  (a, b) => b.data.order - a.data.order,
);
const timeline = await Promise.all(
  rawExperience.map(async (entry) => ({
    id: entry.id,
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
);

const skillGroups = Object.entries(profile.skills);
---

<BaseLayout title="About" description="Who João Guedes is: backend engineer, ex-security, homelab tinkerer and motorcyclist in Porto.">
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-20">
    <p class="eyebrow">The man of the hour</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">About</h1>

    <!-- Hero: portrait + intro -->
    <div class="mt-10 grid gap-8 md:grid-cols-[1fr_17rem] md:items-start">
      <div class="prose order-2 md:order-1">
        <p>
          Hey! I'm João. I'm a backend software engineer at Uphold, based in Braga, Portugal. I love to problem solve, tinker and develop new solutions for problems people don't even realize they have. Above all I love to learn and grow and the tech sector allows me to do that daily. One of my biggest passions is software development, creating things, out of seemengly nothing, fulfills me in ways that few other things can. On the other half of the coin there is security that aims to completely break my thoughtfully crafted software which deeply fascinates me.
        </p>
        <p>
          I came into product engineering from <strong>cybersecurity</strong>, and that lens
          never really leaves you. I think about trust boundaries, logic failures, and the
          blast radius of a change more than is strictly necessary which is a very useful habit and outlook when you're building systems that handle sensitive data.
        </p>
        <p>
          I remain deeply committed to my career as a software and security professional, actively keeping pace with the latest industry developments and security research. This field is a core part of my professional identity. I firmly believe that software engineering and cybersecurity are inseparable; a skilled software engineer must possess solid security knowledge, and a security expert must understand the fundamentals of software development.
        </p>
        <p>
          Outside work I enjoy building and maintaining a <strong>homelab</strong> that's been serving my self-hosted apps since 2022. It's really the perfect place to break things safely, self-host whatever I want, and learn the stuff that doesn't fit into a workday or a university course. When I'm not near a keyboard, I'm probably spending my time riding my motorcycle through open roads or with my dogs.
        </p>
        <p>
          <span class="mr-1">This site is where I keep it all together: the</span>
          <a href={href("/projects")}>projects</a> <span class="mr-1">I've built, the</span>
          <a href={href("/snippets")}>snippets and shortcuts</a> <span class="mr-1">I've accumulated over the years, the</span>
          <a href={href("/blog")}>stories and ramblings</a> I go on and on whenever I find myself in a new adventure and
          the <a href={href("/certifications")}>credentials and certifications</a> I've picked up along the way.
        </p>
      </div>

      <figure class="order-1 mx-auto w-full max-w-[15rem] md:order-2 md:mx-0 md:max-w-none">
        <img
          src={href("/guedes_profile.png")}
          alt="Portrait of João Guedes"
          width="503"
          height="671"
          decoding="async"
          class="w-full rounded-2xl border border-base-300 object-cover shadow-sm"
        />
        <figcaption class="mt-3 text-center text-xs text-base-content/64 md:text-left">
          {profile.tagline}
        </figcaption>
      </figure>
    </div>

    <!-- What I work with -->
    <div class="mt-14 flex items-center gap-4">
      <span class="eyebrow">What I work with</span>
      <span class="h-px flex-1 bg-base-300"></span>
    </div>

    <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
      {
        skillGroups.map(([group, list]) => (
          <div>
            <p class="eyebrow mb-2.5">{group}</p>
            <ul class="flex flex-wrap gap-1.5">
              {list.map((s) => (
                <li class="chip chip-lg">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      profile.softSkills.length > 0 && (
        <div class="mt-8">
          <p class="eyebrow mb-2.5">How I work</p>
          <ul class="flex flex-wrap gap-1.5">
            {profile.softSkills.map((s) => (
              <li class="chip chip-lg">{s}</li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Beyond the code -->
    {
      profile.interests.length > 0 && (
        <>
          <div class="mt-14 flex items-center gap-4">
            <span class="eyebrow">Other Interests</span>
            <span class="h-px flex-1 bg-base-300" />
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {profile.interests.map((it) => (
              <div class="flex items-start gap-3.5 rounded-box border border-base-300 bg-base-100 p-5">
                <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-field border border-base-300 bg-base-200 text-primary">
                  <SystemIcon name={it.icon} size={18} />
                </span>
                <div class="min-w-0">
                  <p class="font-display text-base leading-snug">{it.label}</p>
                  {it.note && <p class="mt-0.5 text-sm leading-relaxed text-base-content/66">{it.note}</p>}
                </div>
              </div>
            ))}
          </div>
        </>
      )
    }

    <!-- The road so far -->
    <div class="mt-14 flex items-center gap-4">
      <span class="eyebrow">The road so far</span>
      <span class="h-px flex-1 bg-base-300"></span>
    </div>

    <section aria-label="Experience timeline" class="mt-8">
      <h2 class="text-2xl">Where I've been</h2>
      {
        timeline.length > 0 ? (
          <ol class="mt-8 space-y-8 border-l border-base-300 pl-6">
            {timeline.map((item) => (
              <li class="relative">
                <span class="dot absolute -left-[1.65rem] top-2" />
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-display text-lg">
                    <a href={href(`/experience/${item.id}`)} class="transition-colors hover:text-primary">
                      {item.data.role} <span class="text-primary">· {item.data.company}</span>
                    </a>
                  </h3>
                  <span class="text-xs text-base-content/64">
                    {item.data.start} - {item.data.end}
                  </span>
                </div>
                {item.data.location && (
                  <p class="text-xs text-base-content/64">{item.data.location}</p>
                )}
                <div class="prose prose-sm mt-2 max-w-none">
                  {item.data.summary}
                </div>
                {item.data.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {item.data.tags.map((t) => (
                      <li class="chip">
                        {t}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <p class="mt-6 text-base-content/66">Timeline coming soon.</p>
        )
      }
      
    </section>
  </section>
</BaseLayout>
