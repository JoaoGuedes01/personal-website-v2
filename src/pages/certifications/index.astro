---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SystemIcon from "../../components/SystemIcon.astro";
import ListSearch from "../../components/ListSearch.astro";
import { iconForProvider } from "../../icons";

const certs = (await getCollection("certifications"))
  .filter((c) => !c.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      a.data.order - b.data.order ||
      b.data.issued.localeCompare(a.data.issued) ||
      a.data.name.localeCompare(b.data.name),
  );

// providers in first-seen order, with counts
const providers: string[] = [];
for (const c of certs) if (!providers.includes(c.data.issuer)) providers.push(c.data.issuer);
const counts = Object.fromEntries(
  providers.map((p) => [p, certs.filter((c) => c.data.issuer === p).length]),
);

const searchItems = certs.map((c) => ({
  title: c.data.name,
  url: c.data.url,
  description: `Issued ${c.data.issued}${c.data.expires ? ` · expires ${c.data.expires}` : ""}`,
  meta: c.data.issuer,
  tags: c.data.skills,
}));
---

<BaseLayout
  title="Certifications"
  description="Certifications held by João Guedes: cloud, security and more, across providers like AWS, INE and Coursera. Filter by provider or search."
>
  <section class="mx-auto max-w-5xl px-4 pt-16 sm:px-6 sm:pt-20">
    <p class="eyebrow">Credentials</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Certifications</h1>
    <p class="mt-4 max-w-2xl text-lg text-base-content/70">
      Certifications and courses worth keeping in record
    </p>

    {
      certs.length > 0 ? (
        <div class="mt-8">
          <ListSearch
            items={searchItems}
            placeholder="Search certifications…"
            label="Search certifications"
            resultsGridClass="grid gap-5 sm:grid-cols-2"
          >
            <Fragment slot="filters">
              <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by provider">
                <button type="button" data-filter="all" class="cert-chip is-active inline-flex items-center gap-1.5 rounded-field border border-base-300 px-3.5 py-1.5 text-xs font-medium transition-colors">
                  <SystemIcon name="layers" size={13} /> All <span class="opacity-60">({certs.length})</span>
                </button>
                {providers.map((p) => (
                  <button type="button" data-filter={p} class="cert-chip inline-flex items-center gap-1.5 rounded-field border border-base-300 px-3.5 py-1.5 text-xs font-medium transition-colors">
                    <SystemIcon name={iconForProvider(p)} size={13} />
                    {p} <span class="opacity-60">({counts[p]})</span>
                  </button>
                ))}
              </div>
            </Fragment>

            <div id="cert-grid" class="mt-8 grid gap-5 sm:grid-cols-2">
              {certs.map((c) => (
                <article
                  class="cert-item card-lift relative flex h-full flex-col rounded-box border border-base-300 bg-base-100 p-6"
                  data-provider={c.data.issuer}
                >
                  <div class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-field border border-base-300 bg-base-200 text-primary">
                      <SystemIcon name={iconForProvider(c.data.issuer)} size={18} />
                    </span>
                    <div class="min-w-0">
                      <p class="eyebrow">{c.data.issuer}</p>
                      <h2 class="font-display text-lg leading-snug">{c.data.name}</h2>
                    </div>
                  </div>

                  <p class="mt-3 text-sm text-base-content/64">
                    Issued {c.data.issued}
                    {c.data.expires && <span class="text-base-content/64"> · expires {c.data.expires}</span>}
                  </p>
                  {c.data.credentialId && (
                    <p class="mt-1 text-xs text-base-content/64">Credential ID: {c.data.credentialId}</p>
                  )}

                  {c.data.skills.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-1.5">
                      {c.data.skills.map((s) => (
                        <li class="chip">{s}</li>
                      ))}
                    </ul>
                  )}

                  {c.data.url && (
                    <a
                      href={c.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="relative z-10 mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary underline-offset-4 hover:underline"
                    >
                      Verify <SystemIcon name="external-link" size={13} />
                    </a>
                  )}
                </article>
              ))}
            </div>

            <p id="cert-empty" class="hidden py-10 text-center text-base-content/64">
              Nothing from this provider yet.
            </p>
          </ListSearch>
        </div>
      ) : (
        <p class="mt-8 text-base-content/66">
          No certifications yet. Add one by dropping a markdown file in
          <code class="rounded bg-base-200 px-1.5 py-0.5 text-[13px]">src/content/certifications/</code>.
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .cert-chip.is-active {
    background: var(--color-primary);
    color: var(--color-primary-content);
    border-color: var(--color-primary);
  }
  .cert-chip:not(.is-active):hover {
    border-color: color-mix(in oklch, var(--color-base-content) 30%, transparent);
  }
</style>

<script is:inline>
  (function () {
    const chips = Array.from(document.querySelectorAll(".cert-chip"));
    const items = Array.from(document.querySelectorAll(".cert-item"));
    const empty = document.getElementById("cert-empty");

    function apply(filter) {
      let shown = 0;
      items.forEach((el) => {
        const match = filter === "all" || el.getAttribute("data-provider") === filter;
        el.style.display = match ? "" : "none";
        if (match) shown++;
      });
      if (empty) empty.classList.toggle("hidden", shown !== 0);
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        apply(chip.getAttribute("data-filter"));
      });
    });
  })();
</script>
