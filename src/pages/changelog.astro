---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemIcon from "../components/SystemIcon.astro";
import { releases, version, formatReleaseDate, type ChangelogKind } from "../utils/changelog";

const repoUrl = "https://github.com/JoaoGuedes01/personal-website-v2";

// Show the most recent releases here; older ones live on GitHub.
const MAX_RELEASES = 12;
const shown = releases.slice(0, MAX_RELEASES);
const hasOlder = releases.length > MAX_RELEASES;

// Long groups (e.g. a dozen "add X snippets") fold behind a "show more".
const VISIBLE_ITEMS = 6;

// Group colour: a semantic daisyUI token per kind.
const tone: Record<ChangelogKind, string> = {
  feature: "var(--color-primary)",
  fix: "var(--color-error)",
  content: "var(--color-accent)",
  docs: "var(--color-info)",
  other: "var(--color-secondary)",
};
---

<BaseLayout
  title="Changelog"
  description={`What's new on joaoguedes.net, current version is v${version}`}
>
  <section class="mx-auto max-w-4xl px-4 pt-16 sm:px-6 sm:pt-20">
    <p class="eyebrow">Release notes</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Changelog</h1>
    <p class="mt-4 max-w-2xl text-lg text-base-content/70">
      Every shiny new feature on the site. Currently on
      <span class="ml-1 font-mono text-base-content/90">v{version}</span>.
    </p>

    {
      releases.length > 0 ? (
        <ol class="mt-12">
          {shown.map((r, i) => (
            <li class="grid gap-x-10 gap-y-4 border-t border-base-300 py-10 first:border-t-0 first:pt-2 md:grid-cols-[10rem_minmax(0,1fr)]">
              <!-- Version, date -->
              <div class="md:sticky md:top-24 md:self-start">
                <h2 class="font-display text-2xl">
                  {r.url ? (
                    <a
                      href={r.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 transition-colors hover:text-primary"
                    >
                      v{r.version}
                      <SystemIcon name="external-link" size={14} class="text-base-content/64" />
                    </a>
                  ) : (
                    <span>v{r.version}</span>
                  )}
                </h2>
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 md:flex-col md:items-start">
                  {r.date && (
                    <span class="inline-flex items-center gap-1.5 text-sm text-base-content/64">
                      <SystemIcon name="calendar" size={13} />
                      {formatReleaseDate(r.date)}
                    </span>
                  )}
                  {i === 0 && <span class="chip chip-solid">Current</span>}
                </div>
              </div>

              <!-- Changes -->
              <div class="min-w-0 space-y-7">
                {r.groups.length > 0 ? (
                  r.groups.map((g) => {
                    const head = g.items.slice(0, VISIBLE_ITEMS);
                    const rest = g.items.slice(VISIBLE_ITEMS);
                    return (
                      <div>
                        <p class="flex items-center gap-2">
                          <span class="chip chip-tone chip-lg" style={`--tone:${tone[g.kind]}`}>{g.title}</span>
                          <span class="text-xs text-base-content/64">{g.items.length}</span>
                        </p>
                        <ul class="changelog-list mt-3">
                          {head.map((it) => (
                            <li class="changelog-item">
                              <span class="changelog-text">
                                {it.scope && <span class="chip changelog-scope">{it.scope}</span>}
                                <span set:html={it.html} />
                              </span>
                              {it.url && (
                                <a href={it.url} target="_blank" rel="noopener noreferrer" class="changelog-hash" aria-label={`Commit ${it.hash?.slice(0, 7)}`}>
                                  {it.hash?.slice(0, 7)}
                                </a>
                              )}
                            </li>
                          ))}
                        </ul>
                        {rest.length > 0 && (
                          <details class="changelog-more mt-1">
                            <summary>
                              <span class="more-closed">Show {rest.length} more</span>
                              <span class="more-open">Show fewer</span>
                            </summary>
                            <ul class="changelog-list mt-1">
                              {rest.map((it) => (
                                <li class="changelog-item">
                                  <span class="changelog-text">
                                    {it.scope && <span class="chip changelog-scope">{it.scope}</span>}
                                    <span set:html={it.html} />
                                  </span>
                                  {it.url && (
                                    <a href={it.url} target="_blank" rel="noopener noreferrer" class="changelog-hash" aria-label={`Commit ${it.hash?.slice(0, 7)}`}>
                                      {it.hash?.slice(0, 7)}
                                    </a>
                                  )}
                                </li>
                              ))}
                            </ul>
                          </details>
                        )}
                      </div>
                    );
                  })
                ) : (
                  <p class="text-sm text-base-content/64">No notable changes recorded.</p>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mt-8 text-base-content/66">No releases yet.</p>
      )
    }

    <div class="mt-6 border-t border-base-300 pt-6">
      {hasOlder && (
        <p class="mb-2 text-sm text-base-content/64">
          Showing the latest {MAX_RELEASES} releases.
        </p>
      )}
      <a
        href={`${repoUrl}/releases`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary underline-offset-4 hover:underline"
      >
        {hasOlder ? "See older releases on GitHub" : "View all releases on GitHub"}
        <SystemIcon name="external-link" size={13} />
      </a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .changelog-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid color-mix(in oklch, var(--color-base-content) 9%, transparent);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: color-mix(in oklch, var(--color-base-content) 86%, transparent);
  }
  .changelog-list > .changelog-item:last-child { border-bottom: 0; }
  .changelog-text code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: var(--radius-selector);
    background: var(--color-base-200);
  }
  .changelog-text a { color: var(--color-primary); text-underline-offset: 3px; }
  .changelog-text a:hover { text-decoration: underline; }
  .changelog-scope {
    margin-right: 0.5rem;
    padding: 0.18rem 0.4rem;
    font-size: 0.6875rem;
    vertical-align: 0.06em;
  }
  .changelog-hash {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: color-mix(in oklch, var(--color-base-content) 64%, transparent);
    text-decoration: none;
  }
  .changelog-hash:hover { color: var(--color-primary); text-decoration: underline; }

  .changelog-more summary {
    display: inline-flex;
    margin-top: 0.4rem;
    padding: 0.2rem 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
  }
  .changelog-more summary::-webkit-details-marker { display: none; }
  .changelog-more summary:hover { text-decoration: underline; text-underline-offset: 3px; }
  .changelog-more .more-open { display: none; }
  .changelog-more[open] .more-open { display: inline; }
  .changelog-more[open] .more-closed { display: none; }
</style>
