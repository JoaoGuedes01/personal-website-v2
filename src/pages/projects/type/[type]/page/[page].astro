---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import ProjectListView from "../../../../../components/ProjectListView.astro";
import { href } from "../../../../../data/site";
import { PROJECT_TYPES } from "../../../../../data/taxonomy";
import { paginate, extraPageNumbers } from "../../../../../utils/paginate";

const sortProjects = (a: any, b: any) =>
  (b.data.year ?? 0) - (a.data.year ?? 0) ||
  a.data.order - b.data.order ||
  a.data.title.localeCompare(b.data.title);

export async function getStaticPaths() {
  const all = (await getCollection("projects")).filter((p) => !p.data.draft);
  const paths: { params: { type: string; page: string }; props: { type: (typeof PROJECT_TYPES)[number] } }[] = [];
  for (const t of PROJECT_TYPES) {
    const inType = all.filter((p) => p.data.type === t.label);
    for (const p of extraPageNumbers(inType)) {
      paths.push({ params: { type: t.slug, page: String(p) }, props: { type: t } });
    }
  }
  return paths;
}

const { type } = Astro.props;
const current = Number(Astro.params.page);
const all = (await getCollection("projects")).filter((p) => !p.data.draft).sort(sortProjects);
const inType = all.filter((p) => p.data.type === type.label);
const page = paginate(inType, current);
---

<BaseLayout
  title={`${type.label} projects — page ${page.current}`}
  description={`${type.label} projects by João Guedes.`}
>
  <ProjectListView
    all={all}
    items={page.items}
    active={type.slug}
    current={page.current}
    total={page.total}
    base={href(`/projects/type/${type.slug}`)}
    eyebrow={`${inType.length} ${type.label.toLowerCase()} ${inType.length === 1 ? "project" : "projects"}`}
    title={`${type.label} projects`}
    intro={type.blurb}
  />
</BaseLayout>
