---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectListView from "../../components/ProjectListView.astro";
import { href } from "../../data/site";
import { paginate } from "../../utils/paginate";

const sortProjects = (a: any, b: any) =>
  (b.data.year ?? 0) - (a.data.year ?? 0) ||
  a.data.order - b.data.order ||
  a.data.title.localeCompare(b.data.title);

const all = (await getCollection("projects")).filter((p) => !p.data.draft).sort(sortProjects);
const page = paginate(all, 1);
---

<BaseLayout title="Projects" description="My projects: personal experiments, university work, and things shipped on the job.">
  <ProjectListView
    all={all}
    items={page.items}
    active="all"
    current={page.current}
    total={page.total}
    base={href("/projects")}
    eyebrow={`${all.length} projects`}
    title="Projects"
    intro="Evergrowing gallery of everything I've built, personal projects, school work and stuff I worked on professionally. If it's here, it's worth talking about and each one's a small piece of how I got to be the engineer I am today."
  />
</BaseLayout>
