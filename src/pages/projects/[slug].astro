---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Gallery from "../../components/Gallery.astro";
import SystemIcon from "../../components/SystemIcon.astro";
import TechBadge from "../../components/TechBadge.astro";
import { readingTime } from "../../utils/reading";
import { projectCover } from "../../utils/covers";
import { href, site } from "../../data/site";
import { resolveTech, TECH_GROUPS } from "../../data/tech";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { title, summary, type, org, orgUrl, category, stack, year, repo, demo, video, gallery } = entry.data;
const cover = projectCover(entry.id);
const { Content, headings } = await render(entry);
const rt = readingTime(entry.body);
const tocCount = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
const hasToc = tocCount >= 2;

// Role(s) this project belongs to: explicit `experience` wins, else match `org`.
// One role links to it directly, several link to the experience index.
const allExperience = (await getCollection("experience")).filter((e) => !e.data.draft);
const linkedRoles = entry.data.experience.length
  ? allExperience.filter((e) => entry.data.experience.includes(e.id))
  : org
    ? allExperience.filter((e) => e.data.company.toLowerCase() === org.toLowerCase())
    : [];
const primaryRole = linkedRoles.length === 1 ? linkedRoles[0] : undefined;
const expCompany = org ?? linkedRoles[0]?.data.company;
const expHref = primaryRole ? href(`/experience/${primaryRole.id}`) : href("/experience");
const showExpLink = linkedRoles.length > 0;

// stack split into groups; each badge links to the filtered projects list
const resolvedStack = stack.map(resolveTech);
const groupedStack = TECH_GROUPS.map((g) => ({
  label: g.label,
  icon: g.icon,
  items: resolvedStack.filter((t) => t.group === g.key),
})).filter((g) => g.items.length > 0);
const techHref = (id: string) => `${href("/projects")}?stack=${id}`;

const shareImage = cover
  ? (await getImage({ src: cover, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 82 })).src
  : `/og/projects/${entry.id}.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: summary,
  image: new URL(shareImage, site.url).toString(),
  author: { "@type": "Person", name: site.name, url: site.url },
  ...(year ? { dateCreated: String(year) } : {}),
  ...(repo ? { codeRepository: repo } : {}),
};
---

<BaseLayout title={title} description={summary} image={shareImage} jsonLd={jsonLd}>
  <div class:list={["mx-auto px-4 pt-14 sm:px-6 sm:pt-20", hasToc ? "max-w-5xl" : "max-w-3xl"]}>
    <a href={href("/projects")} class="inline-flex items-center gap-1 text-sm text-base-content/64 transition-colors hover:text-primary">
      <SystemIcon name="arrow-left" size={14} /> Projects
    </a>

    {
      cover && (
        <figure class="mt-6 overflow-hidden rounded-box border border-base-300 bg-base-200">
          <Image
            src={cover}
            alt={`${title} cover`}
            width={1600}
            class="aspect-[5/2] w-full object-cover"
            loading="eager"
          />
        </figure>
      )
    }

    <div class:list={["mt-6", hasToc && "lg:grid lg:grid-cols-[1fr_15rem] lg:gap-12"]}>
      <article class="min-w-0">
        <header>
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm">
            <span class="eyebrow">
              {type}
              {
                org && (
                  <>
                    {" · "}
                    {orgUrl ? (
                      <a href={orgUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                        {org}
                      </a>
                    ) : (
                      org
                    )}
                  </>
                )
              }
            </span>
            <span class="text-base-content/30">·</span>
            <span class="chip chip-solid">{category}</span>
            {year && <span class="text-xs text-base-content/64">{year}</span>}
          </div>

          <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">{title}</h1>
          <p class="mt-4 text-lg text-base-content/70">{summary}</p>
          <p class="mt-2 text-sm text-base-content/64">{rt.label}</p>

          {
            groupedStack.length > 0 && (
              <div class="mt-6 flex flex-col gap-3">
                {groupedStack.map((g) => (
                  <div class="flex flex-col gap-1.5 sm:flex-row sm:gap-4">
                    <span class="eyebrow flex items-center gap-1.5 pt-1 sm:w-44 sm:shrink-0">
                      <SystemIcon name={g.icon} size={13} />
                      {g.label}
                    </span>
                    <ul class="flex flex-wrap gap-1.5">
                      {g.items.map((t) => (
                        <li>
                          <TechBadge tech={t} href={techHref(t.id)} />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )
          }

          {
            (repo || demo || video || showExpLink) && (
              <div class="mt-5 flex flex-wrap items-center gap-2.5">
                {repo && (
                  <a href={repo} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline rounded-field">
                    View repository ↗
                  </a>
                )}
                {demo && (
                  <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary rounded-field">
                    Live demo ↗
                  </a>
                )}
                {video && (
                  <a href={video} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline gap-1.5 rounded-field">
                    <SystemIcon name="circle-play" size={14} /> Watch video
                  </a>
                )}
                {showExpLink && (
                  <a
                    href={expHref}
                    class="inline-flex items-center gap-1.5 text-sm text-base-content/66 underline-offset-4 hover:text-primary hover:underline"
                  >
                    <SystemIcon name="building-2" size={14} />
                    Part of my work at {expCompany}
                  </a>
                )}
              </div>
            )
          }
        </header>

        {hasToc && <TableOfContents headings={headings} variant="mobile" class="mt-6" />}

        <div class="mt-8 border-t border-base-300 pt-8">
          <div class="prose">
            <Content />
          </div>
        </div>

        {
          gallery.length > 0 && (
            <div class="mt-12 border-t border-base-300 pt-8">
              <p class="eyebrow flex items-center gap-1.5">
                <SystemIcon name="layers" size={14} /> Project Gallery
              </p>
              <h2 class="mt-2 mb-5 text-2xl">See it in action</h2>
              <Gallery images={gallery} />
            </div>
          )
        }
      </article>

      {
        hasToc && (
          <aside class="hidden lg:mt-1 lg:block">
            <div class="lg:sticky lg:top-24">
              <TableOfContents headings={headings} variant="desktop" />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
