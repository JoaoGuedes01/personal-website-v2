---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { href } from "../../data/site";

const roles = (await getCollection("experience"))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.order - a.data.order);

const projects = (await getCollection("projects")).filter((p) => !p.data.draft);
const relatedCount = (company: string) =>
  projects.filter((p) => p.data.org?.toLowerCase() === company.toLowerCase()).length;
---

<BaseLayout
  title="Experience"
  description="Where João Guedes has worked — backend engineering at Uphold, a cybersecurity chapter before that, and the projects that came out of each."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-20">
    <p class="eyebrow">The road so far</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Experience</h1>
    <p class="mt-4 text-lg text-base-content/70">
      Where I've worked and essentially what I did there. Open a role for the details and the projects related to it.
    </p>

    {
      roles.length > 0 ? (
        <div class="mt-10 grid gap-4">
          {roles.map((e) => {
            const count = relatedCount(e.data.company);
            return (
              <a
                href={href(`/experience/${e.id}`)}
                class="card-lift group relative block rounded-box border border-base-300 bg-base-100 p-6"
              >
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h2 class="font-display text-xl leading-snug group-hover:text-primary">
                    {e.data.role} <span class="text-primary">· {e.data.company}</span>
                  </h2>
                  <span class="shrink-0 text-xs text-base-content/50">
                    {e.data.start} — {e.data.end}
                  </span>
                </div>
                {e.data.location && (
                  <p class="mt-0.5 inline-flex items-center gap-1 text-xs text-base-content/45">
                    <Icon name="map-pin" size={12} /> {e.data.location}
                  </p>
                )}
                {e.data.summary && (
                  <p class="mt-2 text-sm leading-relaxed text-base-content/70">{e.data.summary}</p>
                )}
                {e.data.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {e.data.tags.map((t) => (
                      <li class="rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">
                        {t}
                      </li>
                    ))}
                  </ul>
                )}
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
                  Details
                  {count > 0 && <span class="text-base-content/50">· {count} related {count === 1 ? "project" : "projects"}</span>}
                  <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
                </span>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="mt-8 text-base-content/60">Timeline coming soon.</p>
      )
    }

    <p class="mt-10 text-sm text-base-content/60">
      <span class="mr-1">For a TLDR refer to</span>
      <a href={href("/resume")} class="text-primary underline underline-offset-4">my resume →</a>
    </p>
  </section>
</BaseLayout>
