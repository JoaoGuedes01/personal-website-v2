---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Gallery from "../../components/Gallery.astro";
import SystemIcon from "../../components/SystemIcon.astro";
import { href } from "../../data/site";

export async function getStaticPaths() {
  const roles = (await getCollection("experience")).filter((e) => !e.data.draft);
  return roles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"experience">;
}
const { entry } = Astro.props;
const { company, role, start, end, location, tags, highlights, gallery } = entry.data;
const { Content, headings } = await render(entry);
const tocCount = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
const hasToc = tocCount >= 2;

// Projects linked to this role. A project pins itself with `experience: <id>`;
// otherwise, as a zero-config convenience, a project whose `org` matches this
// company is attached — but only when the company has a single role (so a bare
// `org` isn't ambiguous across multiple stints at the same employer).
const allExperience = (await getCollection("experience")).filter((e) => !e.data.draft);
const rolesAtCompany = allExperience.filter(
  (e) => e.data.company.toLowerCase() === company.toLowerCase(),
);
const singleRoleAtCompany = rolesAtCompany.length === 1;

const related = (await getCollection("projects"))
  .filter((p) => {
    if (p.data.draft) return false;
    if (p.data.experience.length) return p.data.experience.includes(entry.id);
    return singleRoleAtCompany && p.data.org?.toLowerCase() === company.toLowerCase();
  })
  .sort(
    (a, b) =>
      (b.data.year ?? 0) - (a.data.year ?? 0) ||
      a.data.order - b.data.order ||
      a.data.title.localeCompare(b.data.title),
  );
---

<BaseLayout title={`${role} · ${company}`} description={entry.data.summary ?? `${role} at ${company}.`}>
  <div class:list={["mx-auto px-4 pt-14 sm:px-6 sm:pt-20", hasToc ? "max-w-5xl" : "max-w-4xl"]}>
    <a href={href("/experience")} class="inline-flex items-center gap-1.5 text-sm text-base-content/55 transition-colors hover:text-primary">
      <SystemIcon name="chevron-left" size={15} /> Experience
    </a>

    <div class:list={["mt-6", hasToc && "lg:grid lg:grid-cols-[1fr_15rem] lg:gap-12"]}>
      <article class="min-w-0">
        <header>
          <p class="eyebrow flex items-center gap-1.5">
            <SystemIcon name="building-2" size={14} /> {company}
          </p>
          <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">{role}</h1>
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-base-content/55">
            <span>{start} - {end}</span>
            {location && (
              <>
                <span class="text-base-content/30">·</span>
                <span class="inline-flex items-center gap-1"><SystemIcon name="map-pin" size={13} /> {location}</span>
              </>
            )}
          </div>
          {
            tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {tags.map((t) => (
                  <li class="rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">{t}</li>
                ))}
              </ul>
            )
          }
        </header>

        {hasToc && <TableOfContents headings={headings} variant="mobile" class="mt-6" />}

        <div class="mt-8 border-t border-base-300 pt-8">
          <div class="prose max-w-none">
            <Content />
          </div>

          {
            highlights.length > 0 && (
              <div class="mt-8">
                <p class="eyebrow mb-3">Highlights</p>
                <ul class="space-y-2">
                  {highlights.map((h) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-base-content/80">
                      <span class="dot mt-2 shrink-0" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        {
          gallery.length > 0 && (
            <div class="mt-12 border-t border-base-300 pt-8">
              <p class="eyebrow flex items-center gap-1.5">
                <SystemIcon name="layers" size={14} /> Gallery
              </p>
              <h2 class="mt-2 mb-5 text-2xl">A closer look</h2>
              <Gallery images={gallery} />
            </div>
          )
        }
      </article>

      {
        hasToc && (
          <aside class="hidden lg:mt-1 lg:block">
            <div class="lg:sticky lg:top-24">
              <TableOfContents headings={headings} variant="desktop" />
            </div>
          </aside>
        )
      }
    </div>

    <section aria-label="Related projects" class="mt-12 border-t border-base-300 pt-10">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">From this role</p>
          <h2 class="mt-2 text-2xl">Related projects</h2>
        </div>
        <span class="shrink-0 text-sm text-base-content/45">{related.length}</span>
      </div>

      {
        related.length > 0 ? (
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {related.map((p) => (
              <ProjectCard entry={p} />
            ))}
          </div>
        ) : (
          <p class="mt-4 text-sm text-base-content/55">
            {
              singleRoleAtCompany ? (
                <>
                  No projects linked yet. Set a project's{" "}
                  <code class="rounded bg-base-200 px-1.5 py-0.5 text-[12px]">org</code> to{" "}
                  <span class="font-medium">"{company}"</span> to have it appear here automatically.
                </>
              ) : (
                <>
                  No projects linked yet. You have more than one role at {company}, so pin a project
                  to <span class="font-medium">this</span> one with{" "}
                  <code class="rounded bg-base-200 px-1.5 py-0.5 text-[12px]">experience: "{entry.id}"</code>{" "}
                  in its frontmatter.
                </>
              )
            }
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
