---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogListView from "../../components/BlogListView.astro";
import { compareBlog } from "../../utils/series";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort(compareBlog);
---

<BaseLayout
  title="Ramblings"
  description="Longer stories about whatever I've been up to: projects, builds, adventures, or things I couldn't stop thinking about."
>
  <BlogListView
    items={posts}
    eyebrow={`${posts.length} ${posts.length === 1 ? "ramble" : "ramblings"}`}
    title="My Ramblings"
    intro="Longer stories about whatever I've been up to. My projects, builds, adventures or simply things I couldn't stop thinking about."
  />
</BaseLayout>
