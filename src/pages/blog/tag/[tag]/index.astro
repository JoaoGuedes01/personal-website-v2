---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import BlogListView from "../../../../components/BlogListView.astro";
import { href } from "../../../../data/site";
import { slugify } from "../../../../data/taxonomy";
import { paginate } from "../../../../utils/paginate";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  const map = new Map<string, string>(); // slug -> first-seen label
  for (const p of posts) for (const t of p.data.tags) {
    const s = slugify(t);
    if (!map.has(s)) map.set(s, t);
  }
  return [...map.entries()].map(([slug, label]) => ({ params: { tag: slug }, props: { label } }));
}

const { label } = Astro.props;
const tag = Astro.params.tag!;
const all = (await getCollection("blog")).filter((p) => !p.data.draft);
const posts = all
  .filter((p) => p.data.tags.some((t) => slugify(t) === tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const page = paginate(posts, 1);
---

<BaseLayout title={`Blog — ${label}`} description={`Blog posts tagged “${label}” by João Guedes.`}>
  <BlogListView
    all={all}
    items={page.items}
    active={tag}
    current={page.current}
    total={page.total}
    base={href(`/blog/tag/${tag}`)}
    activeLabel={label}
  />
</BaseLayout>
