---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Gallery from "../../components/Gallery.astro";
import SystemIcon from "../../components/SystemIcon.astro";
import SearchMeta from "../../components/SearchMeta.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import SeriesBox from "../../components/SeriesBox.astro";
import { buildSeries } from "../../utils/series";
import { slugify } from "../../data/taxonomy";
import { readingTime } from "../../utils/reading";
import { href, site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const visible = posts.filter((p) => !p.data.draft);
  // drafts render in dev only, not in production builds
  const routes = import.meta.env.PROD ? visible : posts;
  return routes.map((entry) => ({ params: { slug: entry.id }, props: { entry, visible, all: posts } }));
}

interface Props {
  entry: CollectionEntry<"blog">;
  visible: CollectionEntry<"blog">[];
  all: CollectionEntry<"blog">[]; // includes drafts, series parts can be drafts
}
const { entry, visible, all } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, gallery } = entry.data;
const { Content, headings } = await render(entry);
const rt = readingTime(entry.body);
const tocCount = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
const hasToc = tocCount >= 2;

// related posts by shared tags, then newest; falls back to newest if nothing overlaps
const mine = new Set(tags.map(slugify));
const others = visible.filter((p) => p.id !== entry.id);
const scored = others
  .map((p) => ({ p, n: p.data.tags.filter((t) => mine.has(slugify(t))).length }))
  .sort((a, b) => b.n - a.n || b.p.data.pubDate.getTime() - a.p.data.pubDate.getTime());
const hasRelated = scored.some((s) => s.n > 0);
const related = (hasRelated ? scored.filter((s) => s.n > 0) : scored).slice(0, 2).map((s) => s.p);

const series = buildSeries(all, entry);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

// Share image: the cover cropped to 1200x630, else a generated card.
const shareImage = cover
  ? (await getImage({ src: cover, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 82 })).src
  : `/og/blog/${entry.id}.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: new URL(shareImage, site.url).toString(),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  keywords: tags.join(", "),
  mainEntityOfPage: new URL(href(`/blog/${entry.id}`), site.url).toString(),
  author: { "@type": "Person", name: site.name, url: site.url },
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={shareImage}
  imageAlt={cover ? coverAlt || title : undefined}
  published={pubDate}
  modified={updatedDate ?? pubDate}
  tags={tags}
  jsonLd={jsonLd}
>
  <div id="read-progress" aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-primary"></div>
  <div class:list={["mx-auto px-4 pt-14 sm:px-6 sm:pt-20", hasToc ? "max-w-5xl" : "max-w-3xl"]}>
    <a href={href("/blog")} class="inline-flex items-center gap-1 text-sm text-base-content/64 transition-colors hover:text-primary">
      <SystemIcon name="arrow-left" size={14} /> Ramblings
    </a>

    <div class:list={["mt-6", hasToc && "lg:grid lg:grid-cols-[1fr_15rem] lg:gap-12"]}>
      <article class="min-w-0">
        <header>
          {
            series && (
              <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
                <a
                  href="#series"
                  class="chip chip-solid chip-lg"
                >
                  <SystemIcon name="layers" size={13} />
                  {series.title} series · Part {series.current} of {series.total}
                </a>
                {series.next?.id && series.next.state === "published" && (
                  <a href={href(`/blog/${series.next.id}`)} class="text-xs font-medium text-base-content/66 transition-colors hover:text-primary">
                    Next: {series.next.title} →
                  </a>
                )}
              </div>
            )
          }
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-base-content/64">
            <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
            <span class="text-base-content/30">·</span>
            <span class="inline-flex items-center gap-1"><SystemIcon name="clock" size={13} /> {rt.label}</span>
            {updatedDate && <span class="text-xs text-base-content/64">· updated {fmt(updatedDate)}</span>}
          </div>

          <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">{title}</h1>
          <p class="mt-4 text-lg text-base-content/70">{description}</p>

          {
            tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {tags.map((t) => (
                  <li>
                    <a
                      href={`${href("/blog")}?tag=${slugify(t)}`}
                      class="chip"
                    >
                      {t}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          {
            cover && (
              <Image
                src={cover}
                alt={coverAlt}
                class="mt-8 w-full rounded-2xl border border-base-300"
                loading="eager"
              />
            )
          }
        </header>

        {hasToc && <TableOfContents headings={headings} variant="mobile" class="mt-6" />}

        <div class="mt-8 border-t border-base-300 pt-8">
          <div class="prose" data-pagefind-body>
            <SearchMeta title={title} type="Ramblings" />
            <Content />
          </div>
        </div>

        {
          gallery.length > 0 && (
            <div class="mt-12 border-t border-base-300 pt-8">
              <p class="eyebrow flex items-center gap-1.5">
                <SystemIcon name="layers" size={14} /> Gallery
              </p>
              <h2 class="mt-2 mb-5 text-2xl">A closer look</h2>
              <Gallery images={gallery} />
            </div>
          )
        }

        {series && <SeriesBox series={series} />}

        {
          !series && related.length > 0 && (
            <section class="mt-12 border-t border-base-300 pt-8" aria-labelledby="more-ramblings">
              <p class="eyebrow">{hasRelated ? "Keep reading" : "Latest"}</p>
              <h2 id="more-ramblings" class="mt-2 mb-5 text-2xl">
                {hasRelated ? "More like this" : "More ramblings"}
              </h2>
              <div class="grid gap-5 sm:grid-cols-2">
                {related.map((p) => <BlogPostCard entry={p} />)}
              </div>
            </section>
          )
        }
      </article>

      {
        hasToc && (
          <aside class="hidden lg:mt-1 lg:block">
            <div class="lg:sticky lg:top-24">
              <TableOfContents headings={headings} variant="desktop" />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // bar at the top that fills as you scroll
  (function () {
    var bar = document.getElementById("read-progress");
    var art = document.querySelector("article");
    if (!bar || !art) return;
    var tick = false;
    function update() {
      tick = false;
      var r = art.getBoundingClientRect();
      var total = r.height - window.innerHeight * 0.6;
      var done = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
      bar.style.transform = "scaleX(" + done + ")";
    }
    window.addEventListener("scroll", function () { if (!tick) { tick = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();
</script>
