---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Gallery from "../../components/Gallery.astro";
import SystemIcon from "../../components/SystemIcon.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import { slugify } from "../../data/taxonomy";
import { readingTime } from "../../utils/reading";
import { href } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const visible = posts.filter((p) => !p.data.draft);
  // Drafts get a page in dev (so you can preview them) but are NOT built for production.
  const routes = import.meta.env.PROD ? visible : posts;
  return routes.map((entry) => ({ params: { slug: entry.id }, props: { entry, visible } }));
}

interface Props {
  entry: CollectionEntry<"blog">;
  visible: CollectionEntry<"blog">[];
}
const { entry, visible } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, gallery } = entry.data;
const { Content, headings } = await render(entry);
const rt = readingTime(entry.body);
const tocCount = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
const hasToc = tocCount >= 2;

// "More like this": other posts ranked by shared tags (then newest). With no
// overlap at all, fall back to the newest posts so the page never dead-ends.
const mine = new Set(tags.map(slugify));
const others = visible.filter((p) => p.id !== entry.id);
const scored = others
  .map((p) => ({ p, n: p.data.tags.filter((t) => mine.has(slugify(t))).length }))
  .sort((a, b) => b.n - a.n || b.p.data.pubDate.getTime() - a.p.data.pubDate.getTime());
const hasRelated = scored.some((s) => s.n > 0);
const related = (hasRelated ? scored.filter((s) => s.n > 0) : scored).slice(0, 2).map((s) => s.p);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={title} description={description}>
  <div id="read-progress" aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-primary"></div>
  <div class:list={["mx-auto px-4 pt-14 sm:px-6 sm:pt-20", hasToc ? "max-w-5xl" : "max-w-3xl"]}>
    <a href={href("/blog")} class="inline-flex items-center gap-1 text-sm text-base-content/55 transition-colors hover:text-primary">
      <SystemIcon name="arrow-left" size={14} /> Ramblings
    </a>

    <div class:list={["mt-6", hasToc && "lg:grid lg:grid-cols-[1fr_15rem] lg:gap-12"]}>
      <article class="min-w-0">
        <header>
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-base-content/50">
            <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
            <span class="text-base-content/30">·</span>
            <span class="inline-flex items-center gap-1"><SystemIcon name="clock" size={13} /> {rt.label}</span>
            {updatedDate && <span class="text-xs text-base-content/40">· updated {fmt(updatedDate)}</span>}
          </div>

          <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">{title}</h1>
          <p class="mt-4 text-lg text-base-content/70">{description}</p>

          {
            tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {tags.map((t) => (
                  <li>
                    <a
                      href={`${href("/blog")}?tag=${slugify(t)}`}
                      class="inline-block rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55 transition-colors hover:border-primary/40 hover:text-primary"
                    >
                      {t}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          {
            cover && (
              <Image
                src={cover}
                alt={coverAlt}
                class="mt-8 w-full rounded-2xl border border-base-300"
                loading="eager"
              />
            )
          }
        </header>

        {hasToc && <TableOfContents headings={headings} variant="mobile" class="mt-6" />}

        <div class="mt-8 border-t border-base-300 pt-8">
          <div class="prose">
            <Content />
          </div>
        </div>

        {
          gallery.length > 0 && (
            <div class="mt-12 border-t border-base-300 pt-8">
              <p class="eyebrow flex items-center gap-1.5">
                <SystemIcon name="layers" size={14} /> Gallery
              </p>
              <h2 class="mt-2 mb-5 text-2xl">A closer look</h2>
              <Gallery images={gallery} />
            </div>
          )
        }

        {
          related.length > 0 && (
            <section class="mt-12 border-t border-base-300 pt-8" aria-labelledby="more-ramblings">
              <p class="eyebrow">{hasRelated ? "Keep reading" : "Latest"}</p>
              <h2 id="more-ramblings" class="mt-2 mb-5 text-2xl">
                {hasRelated ? "More like this" : "More ramblings"}
              </h2>
              <div class="grid gap-5 sm:grid-cols-2">
                {related.map((p) => <BlogPostCard entry={p} />)}
              </div>
            </section>
          )
        }
      </article>

      {
        hasToc && (
          <aside class="hidden lg:mt-1 lg:block">
            <div class="lg:sticky lg:top-24">
              <TableOfContents headings={headings} variant="desktop" />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Thin reading-progress bar across the top, driven by the article's scroll position.
  (function () {
    var bar = document.getElementById("read-progress");
    var art = document.querySelector("article");
    if (!bar || !art) return;
    var tick = false;
    function update() {
      tick = false;
      var r = art.getBoundingClientRect();
      var total = r.height - window.innerHeight * 0.6;
      var done = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
      bar.style.transform = "scaleX(" + done + ")";
    }
    window.addEventListener("scroll", function () { if (!tick) { tick = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();
</script>
