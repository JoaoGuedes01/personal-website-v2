---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogListView from "../../../components/BlogListView.astro";
import { href } from "../../../data/site";
import { paginate, extraPageNumbers } from "../../../utils/paginate";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return extraPageNumbers(posts).map((p) => ({ params: { page: String(p) } }));
}

const current = Number(Astro.params.page);
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const page = paginate(posts, current);
---

<BaseLayout
  title={`Blog — page ${page.current}`}
  description="Longer-form writing on backend engineering, systems, security and the homelab."
>
  <BlogListView
    all={posts}
    items={page.items}
    active="all"
    current={page.current}
    total={page.total}
    base={href("/blog")}
  />
</BaseLayout>
