---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemIcon from "../components/SystemIcon.astro";
import { href } from "../data/site";
import {
  resume,
  type ResumeExperience,
  type ResumeCertification,
} from "../data/resume";

// --- Experience: override (resume.ts) or auto from the experience collection ---
const expEntries = (await getCollection("experience"))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.order - a.data.order);
const autoExperience: ResumeExperience[] = expEntries.map((e) => ({
  company: e.data.company,
  role: e.data.role,
  start: e.data.start,
  end: e.data.end,
  location: e.data.location,
  summary: e.data.summary,
  highlights: (e.data.highlights ?? []).slice(0, 3), // keep it brief
}));
const experience = resume.experience.length
  ? resume.experience
  : autoExperience;

// --- Certifications: override or auto ---
const certEntries = (await getCollection("certifications"))
  .filter((c) => !c.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      a.data.order - b.data.order ||
      b.data.issued.localeCompare(a.data.issued),
  );
const autoCerts: ResumeCertification[] = certEntries.map((c) => ({
  name: c.data.name,
  issuer: c.data.issuer,
  issued: c.data.issued,
  featured: c.data.featured
}));
const certifications = resume.certifications.length
  ? resume.certifications
  : autoCerts;

// --- Projects: chosen ids (resume.ts) or every project flagged `resume: true` ---
const allProjects = (await getCollection("projects")).filter(
  (p) => !p.data.draft,
);
const chosenIds = resume.projects.length
  ? resume.projects
  : allProjects.filter((p) => p.data.resume).map((p) => p.id);
let resumeProjects = chosenIds
  .map((id) => allProjects.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
if (!resume.projects.length) {
  resumeProjects = resumeProjects.sort(
    (a, b) =>
      (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.order - b.data.order,
  );
}
const showOrg = (t: string) => t === "Professional" || t === "Academic";
---

<BaseLayout
  title="Resume"
  description={`Resume of ${resume.name}, ${resume.title}.`}
>
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-20">
    <!-- Header -->
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between"
    >
      <div>
        <p class="eyebrow">Resume</p>
        <h1 class="mt-3 text-4xl sm:text-5xl">{resume.name}</h1>
        <p class="mt-2 text-lg text-base-content/80">{resume.title}</p>
        <p class="text-sm text-base-content/50">{resume.location}</p>
      </div>
      <div class="no-print flex shrink-0 gap-2">
        <a
          href={resume.pdfPath}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm rounded-field"
        >
          <SystemIcon name="file-text" size={15} />Formal CV 
        </a>
        <button
          type="button"
          id="print-btn"
          class="btn btn-outline btn-sm rounded-field">Print</button
        >
      </div>
    </div>

    <p class="mt-6 max-w-2xl text-base leading-relaxed text-base-content/75">
      {resume.summary}
    </p>

    <!-- Experience -->
    <section
      aria-label="Experience"
      class="mt-12 border-t border-base-300 pt-10"
    >
      <h2 class="text-2xl">Experience</h2>
      {
        experience.length > 0 ? (
          <div class="mt-6 space-y-8">
            {experience.map((job) => (
              <article>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-display text-lg">
                    {job.role} <span class="text-primary">· {job.company}</span>
                  </h3>
                  <span class="text-xs text-base-content/50">
                    {job.start} - {job.end}
                  </span>
                </div>
                {job.location && (
                  <p class="text-xs text-base-content/45">{job.location}</p>
                )}
                {job.summary && (
                  <p class="mt-2 text-sm text-base-content/70">{job.summary}</p>
                )}
                {job.highlights.length > 0 && (
                  <ul class="mt-3 space-y-1.5">
                    {job.highlights.map((h) => (
                      <li class="flex gap-3 text-sm text-base-content/80">
                        <span class="dot mt-2 shrink-0" />
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        ) : (
          <p class="mt-4 text-sm text-base-content/55">
            No experience entries yet.
          </p>
        )
      }
    </section>

    <!-- Selected projects -->
    {
      resumeProjects.length > 0 && (
        <section
          aria-label="Selected projects"
          class="mt-12 border-t border-base-300 pt-10"
        >
          <h2 class="text-2xl">Featured projects</h2>
          <ul class="mt-6 space-y-5">
            {resumeProjects.map((p) => (
              <li>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
                  <h3 class="font-display text-base">
                    <a
                      href={href(`/projects/${p.id}`)}
                      class="hover:text-primary"
                    >
                      {p.data.title}
                    </a>
                    {showOrg(p.data.type) && p.data.org && (
                      <span class="text-sm font-normal text-base-content/55">
                        {" "}
                        · {p.data.org}
                      </span>
                    )}
                  </h3>
                  {p.data.year && (
                    <span class="text-xs text-base-content/45">
                      {p.data.year}
                    </span>
                  )}
                </div>
                <p class="mt-0.5 text-sm text-base-content/70">
                  {p.data.summary}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Skills -->
    <section aria-label="Skills" class="mt-12 border-t border-base-300 pt-10">
      <h2 class="text-2xl">Skills</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {
          Object.entries(resume.skills).map(([group, list]) => (
            <div>
              <p class="eyebrow mb-2">{group}</p>
              <ul class="flex flex-wrap gap-1.5">
                {list.map((s) => (
                  <li class="rounded-full border border-base-300 px-2.5 py-0.5 text-xs text-base-content/75">
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      {
        (resume.softSkills.length > 0 || resume.languages.length > 0) && (
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {resume.softSkills.length > 0 && (
              <div>
                <p class="eyebrow mb-2">Soft skills</p>
                <ul class="flex flex-wrap gap-1.5">
                  {resume.softSkills.map((s) => (
                    <li class="rounded-full border border-base-300 px-2.5 py-0.5 text-xs text-base-content/75">
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {resume.languages.length > 0 && (
              <div>
                <p class="eyebrow mb-2">Languages</p>
                <ul class="space-y-1 text-sm text-base-content/75">
                  {resume.languages.map((l) => (
                    <li>
                      <span class="font-medium">{l.name}</span>
                      <span class="text-base-content/55"> · {l.level}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </section>

    <!-- Education -->
    <section
      aria-label="Education"
      class="mt-12 border-t border-base-300 pt-10"
    >
      <h2 class="text-2xl">Education</h2>
      <div class="mt-6 space-y-6">
        {
          resume.education.map((ed) => (
            <article>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-display text-lg">{ed.degree}</h3>
                <span class="text-xs text-base-content/50">
                  {ed.start} - {ed.end}
                </span>
              </div>
              <p class="text-sm text-base-content/70">
                {ed.school}
                {ed.location && (
                  <span class="text-base-content/45"> · {ed.location}</span>
                )}
              </p>
              {ed.detail && (
                <p class="mt-1 text-sm text-base-content/60">{ed.detail}</p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- Certifications -->
    {
      certifications.length > 0 && (
        <section
          aria-label="Certifications"
          class="mt-12 border-t border-base-300 pt-10"
        >
          <div class="flex items-end justify-between gap-4">
            <h2 class="text-2xl">Certifications</h2>
            <a
              href={href("/certifications")}
              class="no-print shrink-0 text-sm text-base-content/55 underline-offset-4 hover:text-primary hover:underline"
            >
              All certifications →
            </a>
          </div>
          <ul class="mt-6 space-y-2">
            {certifications &&
              certifications
                .filter((c) => c.featured)
                .map((c) => (
                  <li class="flex items-baseline justify-between gap-4 text-sm">
                    <span>
                      <span class="font-medium">{c.name}</span>
                      <span class="text-base-content/60"> · {c.issuer}</span>
                    </span>
                    <span class="text-xs text-base-content/50">{c.issued}</span>
                  </li>
                ))}
          </ul>
        </section>
      )
    }
  </section>
</BaseLayout>

<style is:global>
  @media print {
    header,
    footer,
    .no-print {
      display: none !important;
    }
    :root,
    html[data-theme] {
      background: #fff !important;
    }
    body {
      background: #fff !important;
      color: #111 !important;
    }
    section,
    h1,
    h2,
    h3 {
      color: #111 !important;
    }
    .text-primary {
      color: #111 !important;
    }
    a {
      color: #111 !important;
      text-decoration: none !important;
    }
    .dot {
      background: #111 !important;
    }
    main {
      padding-top: 0 !important;
    }
  }
</style>

<script is:inline>
  document
    .getElementById("print-btn")
    ?.addEventListener("click", () => window.print());
</script>
