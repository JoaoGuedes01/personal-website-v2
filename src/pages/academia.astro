---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemIcon from "../components/SystemIcon.astro";
import { href } from "../data/site";
import { education } from "../data/education";

const papers = (await getCollection("papers")).sort((a, b) => {
  if (a.data.kind !== b.data.kind) return a.data.kind === "Thesis" ? -1 : 1;
  return b.data.year - a.data.year;
});

const groups = [
  { label: "Thesis", items: papers.filter((p) => p.data.kind === "Thesis") },
  { label: "Papers", items: papers.filter((p) => p.data.kind !== "Thesis") },
].filter((g) => g.items.length > 0);

// Resolve a paper's PDF path: pass external URLs through, base-prefix local ones.
const asset = (p?: string) => (!p ? undefined : p.startsWith("http") ? p : href(p));

const empty = education.length === 0 && groups.length === 0;
---

<BaseLayout
  title="Academia"
  description="Academic background of João Guedes: education, the master's thesis on healthcare ABI interoperability, and published papers."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-20">
    <p class="eyebrow">Academic work</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Academia</h1>
    <p class="mt-4 text-lg text-base-content/70">
      A small archive of my formal education and published literature
    </p>

    {
      education.length > 0 && (
        <div class="mt-12">
          <p class="eyebrow mb-4 flex items-center gap-1.5">
            <SystemIcon name="graduation-cap" size={14} /> Education
          </p>
          <div class="space-y-6">
            {education.map((ed) => (
              <article class="rounded-box border border-base-300 bg-base-100 p-6">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h2 class="font-display text-xl leading-snug">{ed.degree}</h2>
                  <span class="shrink-0 text-xs text-base-content/64">
                    {ed.start} - {ed.end}
                  </span>
                </div>
                <p class="mt-1 text-sm text-base-content/70">
                  {ed.url ? (
                    <a href={ed.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                      {ed.school}
                    </a>
                  ) : (
                    ed.school
                  )}
                  {ed.location && <span class="text-base-content/64"> · {ed.location}</span>}
                </p>
                {ed.detail && <p class="mt-2 text-sm leading-relaxed text-base-content/75">{ed.detail}</p>}
              </article>
            ))}
          </div>
        </div>
      )
    }

    {
      groups.map((g) => (
        <div class="mt-12">
          <p class="eyebrow mb-4">{g.label}</p>
          <div class="space-y-6">
            {g.items.map((p) => {
              const pdfHref = asset(p.data.pdf);
              return (
                <article class="rounded-box border border-base-300 bg-base-100 p-6">
                  <div class="mb-2 flex items-center gap-3">
                    <span class="eyebrow">{p.data.kind}</span>
                    <span class="text-xs text-base-content/64">{p.data.year}</span>
                  </div>
                  <h2 class="font-display text-xl leading-snug">{p.data.title}</h2>
                  {p.data.authors.length > 0 && (
                    <p class="mt-1 text-sm text-base-content/66">{p.data.authors.join(", ")}</p>
                  )}
                  {p.data.venue && <p class="text-sm text-base-content/64">{p.data.venue}</p>}
                  <p class="mt-3 text-sm leading-relaxed text-base-content/75">{p.data.abstract}</p>

                  {(pdfHref || p.data.link) && (
                    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                      {pdfHref && (
                        <a
                          href={pdfHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 font-medium text-primary underline-offset-4 hover:underline"
                        >
                          <SystemIcon name="file-text" size={14} /> Open PDF ↗
                        </a>
                      )}
                      {pdfHref && (
                        <a
                          href={pdfHref}
                          download
                          class="inline-flex items-center gap-1.5 text-base-content/66 underline-offset-4 hover:text-primary hover:underline"
                        >
                          <SystemIcon name="download" size={14} /> Download
                        </a>
                      )}
                      {p.data.link && (
                        <a
                          href={p.data.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 text-base-content/66 underline-offset-4 hover:text-primary hover:underline"
                        >
                          <SystemIcon name="external-link" size={13} /> View publication ↗
                        </a>
                      )}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      ))
    }

    {empty && <p class="mt-8 text-base-content/66">Nothing here yet.</p>}
  </section>
</BaseLayout>
