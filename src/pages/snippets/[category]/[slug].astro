---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SnippetDetail from "../../../components/SnippetDetail.astro";
import { href } from "../../../data/site";
import { snippetCategorySlug, snippetCategoryByLabel, snippetPath } from "../../../data/taxonomy";

export async function getStaticPaths() {
  const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
  return snips
    .filter((entry) => !snippetPath(entry).group) // grouped ones use the deeper routes
    .map((entry) => ({
      params: { category: snippetCategorySlug(entry.data.category), slug: entry.id },
      props: { entry },
    }));
}

interface Props {
  entry: CollectionEntry<"snippets">;
}
const { entry } = Astro.props;
const catMeta = snippetCategoryByLabel(entry.data.category)!;
const catSlug = snippetCategorySlug(entry.data.category);
const listHref = href(`/snippets/${catSlug}`);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={`/og/snippets/${entry.id}.png`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: entry.data.title,
    description: entry.data.description,
    author: { "@type": "Person", name: "João Guedes" },
  }}
>
  <SnippetDetail
    entry={entry}
    crumbs={[{ label: catMeta.label, href: listHref, icon: catMeta.icon }]}
    listHref={listHref}
    backLabel={catMeta.label}
  />
</BaseLayout>
