---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SnippetDetail from "../../../../components/SnippetDetail.astro";
import { href } from "../../../../data/site";
import { SNIPPET_CATEGORIES, snippetCategorySlug, snippetPath } from "../../../../data/taxonomy";
import { snippetGroupInfo } from "../../../../data/snippetGroups";

export async function getStaticPaths() {
  const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
  const paths: {
    params: { category: string; group: string; slug: string };
    props: { entry: CollectionEntry<"snippets"> };
  }[] = [];
  for (const entry of snips) {
    const { group, subgroup, slug } = snippetPath(entry);
    if (!group || subgroup) continue; // only snippets directly in a subgroup-less group
    paths.push({ params: { category: snippetCategorySlug(entry.data.category), group, slug }, props: { entry } });
  }
  return paths;
}

interface Props {
  entry: CollectionEntry<"snippets">;
}
const { entry } = Astro.props;
const catSlug = snippetCategorySlug(entry.data.category);
const category = SNIPPET_CATEGORIES.find((c) => c.slug === catSlug)!;
const { group: groupSlug } = snippetPath(entry);
const group = snippetGroupInfo(catSlug, groupSlug!);
const catHref = href(`/snippets/${catSlug}`);
const listHref = href(`/snippets/${catSlug}/${groupSlug}`);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <SnippetDetail
    entry={entry}
    crumbs={[
      { label: category.label, href: catHref, icon: category.icon },
      { label: group.label, href: listHref, icon: group.icon },
    ]}
    listHref={listHref}
    backLabel={group.label}
  />
</BaseLayout>
