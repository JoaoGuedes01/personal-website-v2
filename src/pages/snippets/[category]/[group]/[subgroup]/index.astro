---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SnippetListView from "../../../../../components/SnippetListView.astro";
import { href } from "../../../../../data/site";
import { SNIPPET_CATEGORIES, snippetPath } from "../../../../../data/taxonomy";
import { snippetGroupInfo, snippetSubgroupInfo } from "../../../../../data/snippetGroups";

export async function getStaticPaths() {
  const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
  const paths: {
    params: { category: string; group: string; subgroup: string };
    props: { categorySlug: string; groupSlug: string; subgroupSlug: string };
  }[] = [];
  for (const cat of SNIPPET_CATEGORIES) {
    const inCat = snips.filter((s) => s.data.category === cat.label);
    const seen = new Set<string>();
    for (const s of inCat) {
      const { group, subgroup } = snippetPath(s);
      if (!group || !subgroup) continue;
      const key = `${group}/${subgroup}`;
      if (seen.has(key)) continue;
      seen.add(key);
      paths.push({
        params: { category: cat.slug, group, subgroup },
        props: { categorySlug: cat.slug, groupSlug: group, subgroupSlug: subgroup },
      });
    }
  }
  return paths;
}

const { categorySlug, groupSlug, subgroupSlug } = Astro.props;
const category = SNIPPET_CATEGORIES.find((c) => c.slug === categorySlug)!;
const group = snippetGroupInfo(categorySlug, groupSlug);
const subgroup = snippetSubgroupInfo(categorySlug, groupSlug, subgroupSlug);

const items = (await getCollection("snippets"))
  .filter((s) => !s.data.draft && s.data.category === category.label)
  .filter((s) => {
    const p = snippetPath(s);
    return p.group === groupSlug && p.subgroup === subgroupSlug;
  })
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={`${subgroup.label} snippets — ${category.label}`}
  description={`${subgroup.label} snippets by João Guedes — ${subgroup.blurb}`}
>
  <SnippetListView
    icon={subgroup.icon}
    eyebrow={`${category.label} · ${group.label}`}
    title={subgroup.label}
    intro={subgroup.blurb}
    items={items}
    backHref={href(`/snippets/${categorySlug}/${groupSlug}`)}
    backLabel={group.label}
  />
</BaseLayout>
