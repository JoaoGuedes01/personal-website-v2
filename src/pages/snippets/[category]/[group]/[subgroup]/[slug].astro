---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SnippetDetail from "../../../../../components/SnippetDetail.astro";
import { href } from "../../../../../data/site";
import { SNIPPET_CATEGORIES, snippetCategorySlug, snippetPath } from "../../../../../data/taxonomy";
import { snippetGroupInfo, snippetSubgroupInfo } from "../../../../../data/snippetGroups";

export async function getStaticPaths() {
  const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
  const paths: {
    params: { category: string; group: string; subgroup: string; slug: string };
    props: { entry: CollectionEntry<"snippets"> };
  }[] = [];
  for (const entry of snips) {
    const { group, subgroup, slug } = snippetPath(entry);
    if (!group || !subgroup) continue;
    paths.push({ params: { category: snippetCategorySlug(entry.data.category), group, subgroup, slug }, props: { entry } });
  }
  return paths;
}

interface Props {
  entry: CollectionEntry<"snippets">;
}
const { entry } = Astro.props;
const catSlug = snippetCategorySlug(entry.data.category);
const category = SNIPPET_CATEGORIES.find((c) => c.slug === catSlug)!;
const { group: groupSlug, subgroup: subgroupSlug } = snippetPath(entry);
const group = snippetGroupInfo(catSlug, groupSlug!);
const subgroup = snippetSubgroupInfo(catSlug, groupSlug!, subgroupSlug!);
const catHref = href(`/snippets/${catSlug}`);
const groupHref = href(`/snippets/${catSlug}/${groupSlug}`);
const listHref = href(`/snippets/${catSlug}/${groupSlug}/${subgroupSlug}`);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={`/og/snippets/${entry.id}.png`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: entry.data.title,
    description: entry.data.description,
    author: { "@type": "Person", name: "João Guedes" },
  }}
>
  <SnippetDetail
    entry={entry}
    crumbs={[
      { label: category.label, href: catHref, icon: category.icon },
      { label: group.label, href: groupHref, icon: group.icon },
      { label: subgroup.label, href: listHref, icon: subgroup.icon },
    ]}
    listHref={listHref}
    backLabel={subgroup.label}
  />
</BaseLayout>
