---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SnippetCategoryView from "../../../../../components/SnippetCategoryView.astro";
import { href } from "../../../../../data/site";
import { SNIPPET_CATEGORIES, slugify, type Taxon } from "../../../../../data/taxonomy";
import { paginate } from "../../../../../utils/paginate";

export async function getStaticPaths() {
  const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
  const paths: { params: { category: string; tag: string }; props: { category: Taxon; label: string } }[] = [];
  for (const cat of SNIPPET_CATEGORIES) {
    const inCat = snips.filter((s) => s.data.category === cat.label);
    const map = new Map<string, string>(); // tag slug -> first-seen label
    for (const s of inCat) for (const t of s.data.tags) {
      const sl = slugify(t);
      if (!map.has(sl)) map.set(sl, t);
    }
    for (const [slug, label] of map) {
      paths.push({ params: { category: cat.slug, tag: slug }, props: { category: cat, label } });
    }
  }
  return paths;
}

const { category, label } = Astro.props;
const tag = Astro.params.tag!;
const all = (await getCollection("snippets"))
  .filter((s) => !s.data.draft && s.data.category === category.label)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const inTag = all.filter((s) => s.data.tags.some((t) => slugify(t) === tag));
const page = paginate(inTag, 1);
---

<BaseLayout
  title={`${category.label} snippets — ${label}`}
  description={`${category.label} snippets tagged “${label}” by João Guedes.`}
>
  <SnippetCategoryView
    category={category}
    all={all}
    items={page.items}
    active={tag}
    activeLabel={label}
    current={page.current}
    total={page.total}
    count={page.count}
    base={href(`/snippets/${category.slug}/tag/${tag}`)}
  />
</BaseLayout>
