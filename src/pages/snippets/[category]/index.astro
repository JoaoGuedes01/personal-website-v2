---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TaxonCardGrid from "../../../components/TaxonCardGrid.astro";
import SnippetListView from "../../../components/SnippetListView.astro";
import SystemIcon from "../../../components/SystemIcon.astro";
import { href } from "../../../data/site";
import { SNIPPET_CATEGORIES, snippetPath } from "../../../data/taxonomy";
import { snippetGroupInfo, curatedGroupIndex } from "../../../data/snippetGroups";

export async function getStaticPaths() {
  const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
  return SNIPPET_CATEGORIES.filter((cat) =>
    snips.some((s) => s.data.category === cat.label),
  ).map((cat) => ({ params: { category: cat.slug }, props: { category: cat } }));
}

const { category } = Astro.props;
const inCat = (await getCollection("snippets"))
  .filter((s) => !s.data.draft && s.data.category === category.label)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// groups on disk: curated order first, then the rest alphabetically (see snippetGroups.ts)
const groupSlugs = [...new Set(inCat.map((s) => snippetPath(s).group).filter((g): g is string => Boolean(g)))].sort(
  (a, b) => curatedGroupIndex(category.slug, a) - curatedGroupIndex(category.slug, b) || a.localeCompare(b),
);
const groups = groupSlugs.map((slug) => {
  const info = snippetGroupInfo(category.slug, slug);
  return {
    href: href(`/snippets/${category.slug}/${slug}`),
    icon: info.icon,
    label: info.label,
    blurb: info.blurb,
    count: inCat.filter((s) => snippetPath(s).group === slug).length,
  };
});
---

<BaseLayout
  title={`${category.label} snippets`}
  description={`${category.label} snippets by João Guedes: ${category.blurb}`}
>
  {
    groups.length > 0 ? (
      <section class="mx-auto max-w-4xl px-4 pt-14 sm:px-6 sm:pt-20">
        <a href={href("/snippets")} class="text-sm text-base-content/64 transition-colors hover:text-primary">
          ← All snippets
        </a>

        <p class="eyebrow mt-6 flex items-center gap-1.5">
          <SystemIcon name={category.icon} size={14} />
          Snippets
        </p>
        <h1 class="mt-3 text-4xl sm:text-5xl">{category.label}</h1>
        <p class="mt-4 max-w-2xl text-lg text-base-content/70">{category.blurb}</p>

        <div class="mt-8">
          <TaxonCardGrid cards={groups} />
        </div>

        <p class="mt-8 text-sm text-base-content/64">
          {inCat.length} {inCat.length === 1 ? "snippet" : "snippets"} across {groups.length}{" "}
          {groups.length === 1 ? "group" : "groups"}.
        </p>
      </section>
    ) : (
      <SnippetListView
        icon={category.icon}
        eyebrow="Snippets"
        title={category.label}
        intro={category.blurb}
        items={inCat}
        backHref={href("/snippets")}
        backLabel="All snippets"
      />
    )
  }
</BaseLayout>
