---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SnippetCategoryView from "../../../components/SnippetCategoryView.astro";
import { SNIPPET_CATEGORIES } from "../../../data/taxonomy";
import { paginate } from "../../../utils/paginate";

export async function getStaticPaths() {
  const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
  return SNIPPET_CATEGORIES.filter((cat) =>
    snips.some((s) => s.data.category === cat.label),
  ).map((cat) => ({ params: { category: cat.slug }, props: { category: cat } }));
}

const { category } = Astro.props;
const inCat = (await getCollection("snippets"))
  .filter((s) => !s.data.draft && s.data.category === category.label)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const page = paginate(inCat, 1);
---

<BaseLayout
  title={`${category.label} snippets`}
  description={`${category.label} snippets by João Guedes — ${category.blurb}`}
>
  <SnippetCategoryView
    category={category}
    items={page.items}
    current={page.current}
    total={page.total}
    count={page.count}
  />
</BaseLayout>
