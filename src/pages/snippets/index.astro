---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListSearch from "../../components/ListSearch.astro";
import TaxonCardGrid from "../../components/TaxonCardGrid.astro";
import { href } from "../../data/site";
import { readingTime } from "../../utils/reading";
import { SNIPPET_CATEGORIES, snippetCategorySlug, snippetPath, snippetUrl } from "../../data/taxonomy";
import { snippetGroupInfo, snippetSubgroupInfo } from "../../data/snippetGroups";

const snips = (await getCollection("snippets")).filter((s) => !s.data.draft);
const total = snips.length;

// Categories that actually have snippets, in taxonomy order.
const categories = SNIPPET_CATEGORIES.map((cat) => ({
  href: href(`/snippets/${cat.slug}`),
  icon: cat.icon,
  label: cat.label,
  blurb: cat.blurb,
  count: snips.filter((s) => s.data.category === cat.label).length,
})).filter((c) => c.count > 0);

// Global fuzzy-search across every snippet, regardless of class/group.
const searchItems = snips.map((s) => {
  const { group, subgroup } = snippetPath(s);
  const cat = snippetCategorySlug(s.data.category);
  // Human labels for the path line (search still matches on them too).
  const path = [
    s.data.category,
    group && snippetGroupInfo(cat, group).label,
    group && subgroup && snippetSubgroupInfo(cat, group, subgroup).label,
  ].filter(Boolean);
  return {
    title: s.data.title,
    url: snippetUrl(s),
    description: s.data.description,
    meta: path.join(" · "),
    lang: s.data.lang,
    reading: readingTime(s.body).label,
    tags: s.data.tags,
  };
});
---

<BaseLayout
  title="Snippets"
  description="Useful snippets & tech tips"
>
  <section class="mx-auto max-w-4xl px-4 pt-16 sm:px-6 sm:pt-20">
    <p class="eyebrow">Useful snippets &amp; tech tips</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Snippets</h1>
    <p class="mt-4 max-w-2xl text-lg text-base-content/70">
      Small, self-contained solutions I keep reaching for. Commands, configs, one-liners and pretty much anything I don't want to google again
    </p>

    {
      total > 0 ? (
        <div class="mt-8">
          <ListSearch
            items={searchItems}
            placeholder="Search all snippets…"
            label="Search snippets"
            resultsGridClass="grid gap-5 sm:grid-cols-2"
            variant="snippet"
          >
            <Fragment slot="filters"><span /></Fragment>

            {
              categories.length > 0 ? (
                <TaxonCardGrid cards={categories} />
              ) : (
                <p class="text-base-content/60">No snippets yet.</p>
              )
            }

            <p class="mt-8 text-sm text-base-content/50">
              {total} {total === 1 ? "snippet" : "snippets"} across {categories.length}{" "}
              {categories.length === 1 ? "class" : "classes"}.
            </p>
          </ListSearch>
        </div>
      ) : (
        <p class="mt-8 text-base-content/60">No snippets yet.</p>
      )
    }
  </section>
</BaseLayout>
