---
import { Image } from "astro:assets";
import SystemIcon from "./SystemIcon.astro";
import { slugify } from "../data/taxonomy";
import { tileGradient } from "../utils/tile";

interface Props {
  url: string;
  title: string;
  description: string;
  date: Date;
  readingTime?: string;
  category?: string;
  tags?: string[];
  tagBase?: string; // when set, tags link to <tagBase>?tag=<slug>
  lang?: string;
  source?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  // Posts with no cover get a gradient tile tinted by their first tag.
  placeholder?: boolean;
}
const {
  url,
  title,
  description,
  date,
  readingTime,
  category,
  tags = [],
  tagBase,
  lang,
  source,
  cover,
  coverAlt = "",
  placeholder = false,
} = Astro.props;
const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const dateISO = date.toISOString();
const seed = tags[0] ?? title;
const tile = tileGradient(seed);
---

<article
  class:list={[
    "card-lift group relative flex h-full flex-col overflow-hidden rounded-box border border-base-300 bg-base-100",
  ]}
>
  {
    (cover || placeholder) && (
      // Full-bleed 16:9 cover along the top edge of the card, no margins.
      <div class="relative aspect-[16/9] overflow-hidden bg-base-200" style={!cover ? `background:${tile}` : undefined}>
        {cover ? (
          <Image
            src={cover}
            alt={coverAlt}
            class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
          />
        ) : (
          <>
            <span aria-hidden="true" class="pointer-events-none absolute -right-2 -top-6 select-none font-display text-[7rem] leading-none text-white/15">
              {seed.charAt(0).toUpperCase()}
            </span>
            <span aria-hidden="true" class="absolute bottom-3 left-3 rounded-full bg-black/25 px-2.5 py-0.5 text-[11px] font-medium text-white backdrop-blur-sm">
              {tags[0] ?? "rambling"}
            </span>
          </>
        )}
      </div>
    )
  }

  <div class="flex min-w-0 flex-1 flex-col p-6">
    <div class="mb-2 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-base-content/45">
      <time datetime={dateISO}>{dateStr}</time>
      {
        readingTime && (
          <>
            <span class="text-base-content/25">·</span>
            <span class="inline-flex items-center gap-1">
              <SystemIcon name="clock" size={12} />
              {readingTime}
            </span>
          </>
        )
      }
      {
        category && (
          <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-[11px] font-medium text-primary">
            {category}
          </span>
        )
      }
      {
        lang && !category && (
          <span class="rounded-full bg-base-200 px-2.5 py-0.5 text-[11px] text-base-content/60">
            {lang}
          </span>
        )
      }
      {
        source && (
          <span class="inline-flex items-center gap-1 rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">
            <SystemIcon name="book-open" size={11} />
            {source}
          </span>
        )
      }
    </div>

    <h3 class="font-display text-xl leading-snug">
      <a href={url} class="after:absolute after:inset-0 group-hover:text-primary">{title}</a>
    </h3>

    <p class="mt-1.5 line-clamp-3 text-sm leading-relaxed text-base-content/70">{description}</p>

    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((t) => (
            <li>
              {tagBase ? (
                <a
                  href={`${tagBase}?tag=${slugify(t)}`}
                  class="relative z-10 inline-block rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55 transition-colors hover:border-primary/40 hover:text-primary"
                >
                  {t}
                </a>
              ) : (
                <span class="inline-block rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">{t}</span>
              )}
            </li>
          ))}
        </ul>
      )
    }

  </div>
</article>
