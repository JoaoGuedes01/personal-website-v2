---
import { Image } from "astro:assets";
import SystemIcon from "./SystemIcon.astro";

interface Props {
  url: string;
  title: string;
  description: string;
  date: Date;
  readingTime?: string;
  category?: string;
  tags?: string[];
  lang?: string;
  source?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
}
const {
  url,
  title,
  description,
  date,
  readingTime,
  category,
  tags = [],
  lang,
  source,
  cover,
  coverAlt = "",
} = Astro.props;
const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const dateISO = date.toISOString();
---

<article class="card-lift group relative flex flex-col rounded-box border border-base-300 bg-base-100 p-6">
  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt}
        class="mb-4 aspect-[16/9] w-full rounded-lg border border-base-300 object-cover"
        loading="lazy"
      />
    )
  }

  <div class="mb-2 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-base-content/45">
    <time datetime={dateISO}>{dateStr}</time>
    {
      readingTime && (
        <>
          <span class="text-base-content/25">·</span>
          <span class="inline-flex items-center gap-1">
            <SystemIcon name="clock" size={12} />
            {readingTime}
          </span>
        </>
      )
    }
    {
      category && (
        <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-[11px] font-medium text-primary">
          {category}
        </span>
      )
    }
    {
      lang && !category && (
        <span class="rounded-full bg-base-200 px-2.5 py-0.5 text-[11px] text-base-content/60">
          {lang}
        </span>
      )
    }
    {
      source && (
        <span class="inline-flex items-center gap-1 rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">
          <SystemIcon name="book-open" size={11} />
          {source}
        </span>
      )
    }
  </div>

  <h3 class="font-display text-xl leading-snug">
    <a href={url} class="after:absolute after:inset-0 group-hover:text-primary">{title}</a>
  </h3>

  <p class="mt-1.5 text-sm leading-relaxed text-base-content/70">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <li class="rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">
            {t}
          </li>
        ))}
      </ul>
    )
  }
</article>
