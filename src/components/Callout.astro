---
/** For .astro/.mdx pages. Markdown content should use the `:::type[Title]` directive instead (src/plugins/remark-callouts.mjs). `color` overrides the --cc variable. */
import { CALLOUTS, resolveType, resolveColor } from "../data/callouts.mjs";

interface Props {
  type?: string;
  title?: string;
  color?: string;
}

const { type = "note", title, color } = Astro.props;
const key = (resolveType(type) ?? "note") as keyof typeof CALLOUTS;
const def = CALLOUTS[key];
const heading = title ?? def.label;
const custom = resolveColor(color);
---

<aside
  class:list={["callout", `callout-${key}`]}
  role="note"
  style={custom ? `--cc: ${custom}` : undefined}
>
  <div class="callout__header">
    <svg
      class="callout__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={def.icon}
    />
    <span class="callout__title">{heading}</span>
  </div>
  <slot />
</aside>
