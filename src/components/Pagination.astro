---
/**
 * <Pagination /> — page navigation for any paginated list.
 *
 *   <Pagination base={href("/blog")} current={page.current} total={page.total} />
 *
 * Page 1 links to `base`; later pages link to `base/page/N` (see utils/paginate).
 * Renders nothing when there's only one page.
 */
import Icon from "./Icon.astro";
import { pageHref } from "../utils/paginate";

interface Props {
  base: string; // already passed through href()
  current: number;
  total: number;
  class?: string;
}
const { base, current, total, class: cls = "" } = Astro.props;

// Compact page list with ellipses: always show first, last, and neighbours.
function pages(cur: number, tot: number): (number | "…")[] {
  if (tot <= 7) return Array.from({ length: tot }, (_, i) => i + 1);
  const set = new Set<number>([1, tot, cur, cur - 1, cur + 1]);
  const sorted = [...set].filter((n) => n >= 1 && n <= tot).sort((a, b) => a - b);
  const out: (number | "…")[] = [];
  let prev = 0;
  for (const n of sorted) {
    if (prev && n - prev > 1) out.push("…");
    out.push(n);
    prev = n;
  }
  return out;
}
const list = pages(current, total);
---

{
  total > 1 && (
    <nav class:list={["mt-12 flex items-center justify-center gap-1.5", cls]} aria-label="Pagination">
      <a
        href={pageHref(base, current - 1)}
        aria-label="Previous page"
        aria-disabled={!(current > 1)}
        class:list={[
          "inline-flex h-9 w-9 items-center justify-center rounded-field border border-base-300 transition-colors",
          current > 1 ? "hover:border-base-content/30 hover:text-primary" : "pointer-events-none opacity-40",
        ]}
      >
        <Icon name="chevron-left" size={16} />
      </a>

      {list.map((p) =>
        p === "…" ? (
          <span class="px-1.5 text-sm text-base-content/40">…</span>
        ) : (
          <a
            href={pageHref(base, p)}
            aria-label={`Page ${p}`}
            aria-current={p === current ? "page" : undefined}
            class:list={[
              "inline-flex h-9 min-w-9 items-center justify-center rounded-field border px-2 text-sm transition-colors",
              p === current
                ? "border-primary bg-primary text-primary-content"
                : "border-base-300 text-base-content/70 hover:border-base-content/30 hover:text-primary",
            ]}
          >
            {p}
          </a>
        ),
      )}

      <a
        href={pageHref(base, current + 1)}
        aria-label="Next page"
        aria-disabled={!(current < total)}
        class:list={[
          "inline-flex h-9 w-9 items-center justify-center rounded-field border border-base-300 transition-colors",
          current < total ? "hover:border-base-content/30 hover:text-primary" : "pointer-events-none opacity-40",
        ]}
      >
        <Icon name="chevron-right" size={16} />
      </a>
    </nav>
  )
}
