---
/** Captioned image for .mdx posts. Plain markdown images are already optimized, use this only when you need a caption. `src` can be an import or a /public path. */
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  class?: string;
}

const { src, alt, caption, class: cls = "" } = Astro.props;
const isImported = typeof src !== "string";
---

<figure class:list={["my-8", cls]}>
  {
    isImported ? (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        class="w-full rounded-xl border border-base-300"
        loading="lazy"
      />
    ) : (
      <img
        src={src as string}
        alt={alt}
        class="w-full rounded-xl border border-base-300"
        loading="lazy"
        decoding="async"
      />
    )
  }
  {caption && <figcaption class="mt-2 text-center text-sm text-base-content/64">{caption}</figcaption>}
</figure>
