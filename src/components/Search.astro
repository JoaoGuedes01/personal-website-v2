---
import { href } from "../data/site";
import SystemIcon from "./SystemIcon.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<button
  type="button"
  id="search-open"
  class="btn btn-ghost btn-sm gap-2 px-2 font-normal text-base-content/66"
  aria-label="Search the site"
  aria-keyshortcuts="Control+K Meta+K"
>
  <SystemIcon name="search" size={18} />
  <kbd class="kbd kbd-xs hidden sm:inline-flex" id="search-kbd">Ctrl K</kbd>
</button>

<dialog id="search-dialog" class="search-dialog" aria-label="Search" data-base={base} data-home={href("/")}>
  <div class="search-panel">
    <div class="flex items-center gap-2 border-b border-base-300 px-4">
      <SystemIcon name="search" size={18} />
      <input
        id="search-input"
        type="search"
        placeholder="Search projects, snippets and ramblings"
        autocomplete="off"
        spellcheck="false"
        class="h-14 w-full bg-transparent text-base outline-none placeholder:text-base-content/50"
        aria-label="Search"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
      />
      <button type="button" id="search-close" class="btn btn-ghost btn-xs" aria-label="Close search">Esc</button>
    </div>
    <ul id="search-results" role="listbox" class="max-h-[60vh] overflow-y-auto p-2"></ul>
    <p id="search-status" class="px-4 py-3 text-sm text-base-content/60" aria-live="polite">Type to search.</p>
  </div>
</dialog>

<script is:inline>
  // Plain JS on purpose: bundled, Vite rewrites the dynamic import of the Pagefind file and leaves a
  // broken placeholder in production builds. This file has no imports, so it can stay as it is.
  const dialog = document.getElementById("search-dialog");
  const input = document.getElementById("search-input");
  const list = document.getElementById("search-results");
  const status = document.getElementById("search-status");
  const kbd = document.getElementById("search-kbd");
  const base = dialog.dataset.base ?? "";

  if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = "⌘ K";

  let pf;
  async function load() {
    if (pf !== undefined) return pf;
    try {
      pf = await import(`${base}/pagefind/pagefind.js`);
    } catch {
      pf = null;
    }
    return pf;
  }

  let active = -1;
  const items = () => Array.from(list.querySelectorAll("a"));
  function setActive(i) {
    const els = items();
    if (!els.length) return;
    active = (i + els.length) % els.length;
    els.forEach((el, n) => {
      el.parentElement.toggleAttribute("data-active", n === active);
      el.parentElement.setAttribute("aria-selected", String(n === active));
    });
    input.setAttribute("aria-activedescendant", els[active].parentElement.id);
    els[active].scrollIntoView({ block: "nearest" });
  }

  function render(rows) {
    list.replaceChildren();
    active = -1;
    input.removeAttribute("aria-activedescendant");
    for (const r of rows) {
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.id = `search-opt-${list.children.length}`;
      const a = document.createElement("a");
      a.href = r.url;
      a.className = "search-hit";
      const head = document.createElement("span");
      head.className = "flex items-baseline justify-between gap-3";
      const t = document.createElement("span");
      t.className = "font-medium";
      t.textContent = r.title;
      const k = document.createElement("span");
      k.className = "shrink-0 text-xs text-base-content/55";
      k.textContent = r.type;
      head.append(t, k);
      const ex = document.createElement("span");
      ex.className = "search-excerpt";
      ex.innerHTML = r.excerpt; // pagefind escapes the text and only adds <mark>
      a.append(head, ex);
      li.append(a);
      list.append(li);
    }
    input.setAttribute("aria-expanded", String(rows.length > 0));
  }

  let seq = 0;
  async function run(q) {
    const mine = ++seq;
    if (!q.trim()) {
      render([]);
      status.textContent = "Type to search.";
      return;
    }
    const engine = await load();
    if (!engine) {
      render([]);
      status.textContent = "Search is only available in the built site.";
      return;
    }
    const res = await engine.debouncedSearch(q, {}, 120);
    if (!res || mine !== seq) return;
    const data = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
    if (mine !== seq) return;
    render(
      data.map((d) => ({
        url: d.url,
        title: d.meta?.title ?? d.url,
        type: d.meta?.type ?? "",
        excerpt: d.excerpt,
      })),
    );
    status.textContent = data.length ? `${res.results.length} result${res.results.length === 1 ? "" : "s"}` : "No results.";
    if (data.length) setActive(0);
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    input.focus();
    input.select();
    void load();
  }

  document.getElementById("search-open")?.addEventListener("click", open);
  document.getElementById("search-close")?.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close(); // click on the backdrop
  });
  input.addEventListener("input", () => void run(input.value));
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") (e.preventDefault(), setActive(active + 1));
    else if (e.key === "ArrowUp") (e.preventDefault(), setActive(active - 1));
    else if (e.key === "Enter") items()[Math.max(active, 0)]?.click();
  });
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
</script>

<style is:global>
  .search-dialog {
    margin: 12vh auto auto;
    width: min(42rem, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box);
    background: var(--color-base-100);
    color: var(--color-base-content);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.45);
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  .search-dialog input[type="search"]::-webkit-search-cancel-button {
    display: none;
  }
  .search-hit {
    display: block;
    border-radius: var(--radius-field);
    padding: 0.6rem 0.75rem;
  }
  li[data-active] > .search-hit,
  .search-hit:hover {
    background: color-mix(in oklab, var(--color-primary) 14%, transparent);
  }
  .search-excerpt {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: color-mix(in oklab, var(--color-base-content) 66%, transparent);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .search-excerpt mark {
    background: color-mix(in oklab, var(--color-primary) 28%, transparent);
    color: inherit;
    border-radius: 2px;
  }
</style>
