---
/**
 * One page of a snippet class: header, tag filter, grid of snippets, pagination.
 * Shared by /snippets/[category], its /page/[page], and the tag-filtered routes
 * /snippets/[category]/tag/[tag]. Tag chips are real navigation, so they work
 * with pagination.
 */
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";
import Icon from "./Icon.astro";
import { readingTime } from "../utils/reading";
import { href } from "../data/site";
import { snippetUrl, slugify, type Taxon } from "../data/taxonomy";

interface Props {
  category: Taxon;
  all: CollectionEntry<"snippets">[]; // all snippets in this class (for tag chips)
  items: CollectionEntry<"snippets">[]; // current page
  active: string; // "all" or a tag slug
  activeLabel?: string; // original tag label when filtered
  current: number;
  total: number; // total pages
  count: number; // snippets in the current view
  base: string; // pagination base, already href()'d
}
const { category, all, items, active, activeLabel, current, total, count, base } = Astro.props;

// Distinct tags within this class → filter chips.
const tagMap = new Map<string, { label: string; count: number }>();
for (const s of all) {
  for (const t of s.data.tags) {
    const slug = slugify(t);
    const e = tagMap.get(slug) ?? { label: t, count: 0 };
    e.count++;
    tagMap.set(slug, e);
  }
}
const chips = [
  { label: "All", slug: "all", icon: "layers", href: href(`/snippets/${category.slug}`), count: all.length },
  ...[...tagMap.entries()]
    .sort((a, b) => b[1].count - a[1].count || a[1].label.localeCompare(b[1].label))
    .map(([slug, { label, count }]) => ({
      label,
      slug,
      icon: "hash",
      href: href(`/snippets/${category.slug}/tag/${slug}`),
      count,
    })),
];
const filtered = active !== "all";
---

<section class="mx-auto max-w-3xl px-4 pt-14 sm:px-6 sm:pt-20">
  <a href={href("/snippets")} class="text-sm text-base-content/55 transition-colors hover:text-primary">
    ← All snippets
  </a>

  <p class="eyebrow mt-6 flex items-center gap-1.5">
    <Icon name={category.icon} size={14} fill="currentColor" stroke="currentColor" />
    Snippets
  </p>
  <h1 class="mt-3 text-4xl sm:text-5xl">{category.label}</h1>
  <p class="mt-4 max-w-2xl text-lg text-base-content/70">
    {filtered ? `${category.label} snippets tagged “${activeLabel ?? active}”.` : category.blurb}
  </p>

  {
    tagMap.size > 0 && (
      <div class="mt-6 flex flex-wrap gap-2" aria-label="Filter by tag">
        {chips.map((c) => (
          <a
            href={c.href}
            aria-current={c.slug === active ? "page" : undefined}
            class:list={[
              "filter-chip inline-flex items-center gap-1.5 rounded-field border border-base-300 px-3.5 py-1.5 text-xs font-medium transition-colors",
              c.slug === active && "is-active",
            ]}
          >
            <Icon name={c.icon} size={13} />
            {c.label} <span class="opacity-60">({c.count})</span>
          </a>
        ))}
      </div>
    )
  }

  <p class="mt-4 text-sm text-base-content/45">
    {count} {count === 1 ? "snippet" : "snippets"}
    {total > 1 && <> · page {current} of {total}</>}
  </p>

  {
    items.length > 0 ? (
      <div class="mt-8 grid gap-5">
        {items.map((p) => (
          <PostCard
            url={snippetUrl(p)}
            title={p.data.title}
            description={p.data.description}
            date={p.data.pubDate}
            readingTime={readingTime(p.body).label}
            tags={p.data.tags}
            lang={p.data.lang}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-base-content/60">
        {filtered ? "No snippets with this tag yet." : "Nothing in this class yet."}
      </p>
    )
  }

  <Pagination base={base} current={current} total={total} />
</section>

<style>
  .filter-chip.is-active {
    background: var(--color-primary);
    color: var(--color-primary-content);
    border-color: var(--color-primary);
  }
  .filter-chip:not(.is-active):hover {
    border-color: color-mix(in oklch, var(--color-base-content) 30%, transparent);
  }
</style>
