---
/**
 * Renders one page of a snippet category: header, grid of snippets, and the
 * pagination control. Shared by /snippets/[category] (page 1) and
 * /snippets/[category]/page/[page] so both stay identical.
 */
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";
import Icon from "./Icon.astro";
import { readingTime } from "../utils/reading";
import { href } from "../data/site";
import { snippetUrl, type Taxon } from "../data/taxonomy";

interface Props {
  category: Taxon;
  items: CollectionEntry<"snippets">[];
  current: number;
  total: number; // total pages
  count: number; // total snippets in this category
}
const { category, items, current, total, count } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 pt-14 sm:px-6 sm:pt-20">
  <a href={href("/snippets")} class="text-sm text-base-content/55 transition-colors hover:text-primary">
    ← All snippets
  </a>

  <p class="eyebrow mt-6 flex items-center gap-1.5">
    <Icon name={category.icon} size={14} />
    Snippets
  </p>
  <h1 class="mt-3 text-4xl sm:text-5xl">{category.label}</h1>
  <p class="mt-4 max-w-2xl text-lg text-base-content/70">{category.blurb}</p>
  <p class="mt-2 text-sm text-base-content/45">
    {count} {count === 1 ? "snippet" : "snippets"}
    {total > 1 && <> · page {current} of {total}</>}
  </p>

  {
    items.length > 0 ? (
      <div class="mt-8 grid gap-5">
        {items.map((p) => (
          <PostCard
            url={snippetUrl(p)}
            title={p.data.title}
            description={p.data.description}
            date={p.data.pubDate}
            readingTime={readingTime(p.body).label}
            tags={p.data.tags}
            lang={p.data.lang}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-base-content/60">Nothing in this class yet.</p>
    )
  }

  <Pagination base={href(`/snippets/${category.slug}`)} current={current} total={total} />
</section>
