---
import SystemIcon from "./SystemIcon.astro";

interface Props {
  url: string;
  title: string;
  description: string;
  readingTime?: string;
  tags?: string[];
  lang?: string;
}
const { url, title, description, readingTime, tags = [], lang } = Astro.props;
const MAX_TAGS = 3;
const shown = tags.slice(0, MAX_TAGS);
const extra = tags.length - shown.length;
---

<article class="card-lift group relative flex flex-col rounded-box border border-base-300 bg-base-100 p-6 hover:border-primary/40">
  <div class="flex items-center gap-2 text-xs text-base-content/64">
    {lang && <span class="rounded-md bg-base-200 px-2 py-0.5 font-mono text-[11px] text-base-content/70">{lang}</span>}
    {
      readingTime && (
        <span class="inline-flex items-center gap-1">
          <SystemIcon name="clock" size={12} />
          {readingTime}
        </span>
      )
    }
    <SystemIcon
      name="arrow-up-right"
      size={15}
      class="ml-auto -translate-x-1 translate-y-1 text-base-content/30 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:text-primary group-hover:opacity-100"
    />
  </div>

  <h3 class="mt-3 font-display text-xl leading-snug">
    <a href={url} class="after:absolute after:inset-0 group-hover:text-primary">{title}</a>
  </h3>

  <p class="mt-1.5 text-sm leading-relaxed text-base-content/70">{description}</p>

  {
    shown.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-base-content/64">
        {shown.map((t) => (
          <li>
            <span class="text-base-content/25">#</span>
            {t}
          </li>
        ))}
        {extra > 0 && <li class="text-base-content/64">+{extra}</li>}
      </ul>
    )
  }
</article>
