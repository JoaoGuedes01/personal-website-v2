---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import TableOfContents from "./TableOfContents.astro";
import Gallery from "./Gallery.astro";
import SystemIcon from "./SystemIcon.astro";
import { readingTime } from "../utils/reading";
import { slugify } from "../data/taxonomy";
import { href } from "../data/site";

export interface Crumb {
  label: string;
  href: string;
  icon: string;
}
interface Props {
  entry: CollectionEntry<"snippets">;
  crumbs: Crumb[]; // category, then group, then subgroup (when they exist)
  listHref: string; // parent listing, used for the back link and ?tag= links
  backLabel?: string; // unused, breadcrumbs cover it
}
const { entry, crumbs, listHref } = Astro.props;
const { title, description, pubDate, lang, tags, gallery, source } = entry.data;
const { Content, headings } = await render(entry);
const rt = readingTime(entry.body);
const tocCount = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
const hasToc = tocCount >= 2;
const dateStr = pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<div class:list={["mx-auto px-4 pt-14 sm:px-6 sm:pt-20", hasToc ? "max-w-5xl" : "max-w-3xl"]}>
  <nav aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-base-content/64">
      <li>
        <a href={href("/snippets")} class="transition-colors hover:text-primary">Snippets</a>
      </li>
      {
        crumbs.map((c, i) => (
          <li class="inline-flex items-center gap-1.5">
            <SystemIcon name="chevron-right" size={13} class="text-base-content/30" />
            <a
              href={c.href}
              aria-current={i === crumbs.length - 1 ? "page" : undefined}
              class="inline-flex items-center gap-1.5 transition-colors hover:text-primary"
            >
              <SystemIcon name={c.icon} size={13} />
              {c.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class:list={["mt-8", hasToc && "lg:grid lg:grid-cols-[1fr_15rem] lg:gap-12"]}>
    <article class="min-w-0">
      <header>
        <h1 class="text-3xl leading-tight sm:text-4xl">{title}</h1>
        <p class="mt-3 text-lg text-base-content/70">{description}</p>

        <p class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-base-content/64">
          <span class="rounded-md bg-base-200 px-2 py-0.5 font-mono text-xs text-base-content/70">{lang}</span>
          <span class="text-base-content/25">·</span>
          <span>{rt.label}</span>
          <span class="text-base-content/25">·</span>
          <time datetime={pubDate.toISOString()}>{dateStr}</time>
          {
            source && (
              <>
                <span class="text-base-content/25">·</span>
                <span class="inline-flex items-center gap-1">
                  <SystemIcon name="book-open" size={13} />
                  {source}
                </span>
              </>
            )
          }
        </p>
      </header>

      {hasToc && <TableOfContents headings={headings} variant="mobile" class="mt-6" />}

      <div class="mt-8 border-t border-base-300 pt-8">
        <div class="prose">
          <Content />
        </div>
      </div>

      {
        tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-1.5 border-t border-base-300 pt-6">
            {tags.map((t) => (
              <li>
                <a
                  href={`${listHref}?tag=${slugify(t)}`}
                  class="chip"
                >
                  {t}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        gallery.length > 0 && (
          <div class="mt-12 border-t border-base-300 pt-8">
            <p class="eyebrow flex items-center gap-1.5">
              <SystemIcon name="layers" size={14} /> Gallery
            </p>
            <h2 class="mt-2 mb-5 text-2xl">A closer look</h2>
            <Gallery images={gallery} />
          </div>
        )
      }
    </article>

    {
      hasToc && (
        <aside class="hidden lg:mt-1 lg:block">
          <div class="lg:sticky lg:top-24">
            <TableOfContents headings={headings} variant="desktop" />
          </div>
        </aside>
      )
    }
  </div>
</div>
