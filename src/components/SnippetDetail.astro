---
/**
 * <SnippetDetail /> — a single snippet's page body: breadcrumb chips, header,
 * tags, content, optional gallery/TOC. Shared by the three detail routes
 * (groupless, grouped, subgrouped) — only the breadcrumb chain and the
 * back/tag-filter target differ per depth.
 */
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import TableOfContents from "./TableOfContents.astro";
import Gallery from "./Gallery.astro";
import SystemIcon from "./SystemIcon.astro";
import { readingTime } from "../utils/reading";
import { slugify } from "../data/taxonomy";

export interface Crumb {
  label: string;
  href: string;
  icon: string;
}
interface Props {
  entry: CollectionEntry<"snippets">;
  crumbs: Crumb[]; // category [, group [, subgroup]], in order
  listHref: string; // immediate parent listing — back link + tag ?tag= target
  backLabel: string;
}
const { entry, crumbs, listHref, backLabel } = Astro.props;
const { title, description, pubDate, lang, tags, gallery, source } = entry.data;
const { Content, headings } = await render(entry);
const rt = readingTime(entry.body);
const tocCount = headings.filter((h) => h.depth === 2 || h.depth === 3).length;
const hasToc = tocCount >= 2;
const dateStr = pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<div class:list={["mx-auto px-4 pt-14 sm:px-6 sm:pt-20", hasToc ? "max-w-5xl" : "max-w-3xl"]}>
  <a
    href={listHref}
    class="inline-flex items-center gap-1.5 text-sm text-base-content/55 transition-colors hover:text-primary"
  >
    <SystemIcon name="chevron-left" size={15} />
    {backLabel}
  </a>

  <div class:list={["mt-6", hasToc && "lg:grid lg:grid-cols-[1fr_15rem] lg:gap-12"]}>
    <article class="min-w-0">
      <header>
        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-base-content/50">
          <time datetime={pubDate.toISOString()}>{dateStr}</time>
          <span class="text-base-content/30">·</span>
          <span>{rt.label}</span>
          {
            crumbs.map((c) => (
              <a
                href={c.href}
                class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-0.5 text-[11px] font-medium text-primary transition-colors hover:bg-primary/20"
              >
                <SystemIcon name={c.icon} size={11} />
                {c.label}
              </a>
            ))
          }
          <span class="rounded-full bg-base-200 px-2.5 py-0.5 text-[11px] text-base-content/60">{lang}</span>
          {
            source && (
              <span class="inline-flex items-center gap-1 rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55">
                <SystemIcon name="book-open" size={11} />
                {source}
              </span>
            )
          }
        </div>

        <h1 class="mt-3 text-3xl leading-tight sm:text-4xl">{title}</h1>
        <p class="mt-3 text-lg text-base-content/70">{description}</p>

        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <li>
                  <a
                    href={`${listHref}?tag=${slugify(t)}`}
                    class="inline-block rounded-full border border-base-300 px-2.5 py-0.5 text-[11px] text-base-content/55 transition-colors hover:border-base-content/30 hover:text-primary"
                  >
                    {t}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {hasToc && <TableOfContents headings={headings} variant="mobile" class="mt-6" />}

      <div class="mt-8 border-t border-base-300 pt-8">
        <div class="prose">
          <Content />
        </div>
      </div>

      {
        gallery.length > 0 && (
          <div class="mt-12 border-t border-base-300 pt-8">
            <p class="eyebrow flex items-center gap-1.5">
              <SystemIcon name="layers" size={14} /> Gallery
            </p>
            <h2 class="mt-2 mb-5 text-2xl">A closer look</h2>
            <Gallery images={gallery} />
          </div>
        )
      }
    </article>

    {
      hasToc && (
        <aside class="hidden lg:mt-1 lg:block">
          <div class="lg:sticky lg:top-24">
            <TableOfContents headings={headings} variant="desktop" />
          </div>
        </aside>
      )
    }
  </div>
</div>
