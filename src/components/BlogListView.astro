---
/**
 * One page of the blog index: header, tag filter, search, grid of posts,
 * pagination. Shared by /blog, /blog/page/[page], and /blog/tag/<tag>.
 *
 * Tag chips are real navigation (each links to /blog or /blog/tag/<slug>), so
 * they play nice with pagination. The search box is a global fuzzy find.
 */
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";
import ListSearch from "./ListSearch.astro";
import Icon from "./Icon.astro";
import { readingTime } from "../utils/reading";
import { href } from "../data/site";
import { slugify } from "../data/taxonomy";

interface Props {
  all: CollectionEntry<"blog">[]; // all non-draft posts (chips + search)
  items: CollectionEntry<"blog">[]; // current page
  active: string; // "all" or a tag slug
  current: number;
  total: number;
  base: string; // pagination base, already href()'d
  activeLabel?: string; // original tag label when filtered
}
const { all, items, active, current, total, base, activeLabel } = Astro.props;

// Distinct tags across all posts → filter chips.
const tagMap = new Map<string, { label: string; count: number }>();
for (const p of all) {
  for (const t of p.data.tags) {
    const slug = slugify(t);
    const e = tagMap.get(slug) ?? { label: t, count: 0 };
    e.count++;
    tagMap.set(slug, e);
  }
}
const chips = [
  { label: "All", slug: "all", icon: "layers", href: href("/blog"), count: all.length },
  ...[...tagMap.entries()]
    .sort((a, b) => b[1].count - a[1].count || a[1].label.localeCompare(b[1].label))
    .map(([slug, { label, count }]) => ({
      label,
      slug,
      icon: "hash",
      href: href(`/blog/tag/${slug}`),
      count,
    })),
];

const filtered = active !== "all";

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
const searchItems = all.map((p) => ({
  title: p.data.title,
  url: href(`/blog/${p.id}`),
  description: p.data.description,
  meta: fmt(p.data.pubDate),
  tags: p.data.tags,
}));
---

<section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-20">
  <p class="eyebrow">Things worth writing about</p>
  <h1 class="mt-4 text-4xl sm:text-5xl">My Ramblings</h1>
  <p class="mt-4 text-lg text-base-content/70">
    {
      filtered
        ? `Pieces tagged “${activeLabel ?? active}”.`
        : "Longer stories about whatever I've been up to. My projects, builds, adventures or simply things I couldn't stop thinking about."
    }
  </p>

  <div class="mt-8">
    <ListSearch
      items={searchItems}
      placeholder="Search posts…"
      label="Search posts"
      resultsGridClass="grid gap-5 sm:grid-cols-2"
    >
      <Fragment slot="filters">
        {
          tagMap.size > 0 ? (
            <div class="flex flex-wrap gap-2" aria-label="Filter by tag">
              {chips.map((c) => (
                <a
                  href={c.href}
                  aria-current={c.slug === active ? "page" : undefined}
                  class:list={[
                    "filter-chip inline-flex items-center gap-1.5 rounded-field border border-base-300 px-3.5 py-1.5 text-xs font-medium transition-colors",
                    c.slug === active && "is-active",
                  ]}
                >
                  <Icon name={c.icon} size={13} />
                  {c.label} <span class="opacity-60">({c.count})</span>
                </a>
              ))}
            </div>
          ) : (
            <span />
          )
        }
      </Fragment>

      {total > 1 && <p class="mt-4 text-sm text-base-content/45">Page {current} of {total}</p>}

      {
        items.length > 0 ? (
          <div class="mt-8 grid gap-5">
            {items.map((p) => (
              <PostCard
                url={href(`/blog/${p.id}`)}
                title={p.data.title}
                description={p.data.description}
                date={p.data.pubDate}
                readingTime={readingTime(p.body).label}
                tags={p.data.tags}
                cover={p.data.cover}
                coverAlt={p.data.coverAlt}
              />
            ))}
          </div>
        ) : (
          <p class="mt-8 text-base-content/60">{filtered ? "No posts with this tag yet." : "First post coming soon."}</p>
        )
      }

      <Pagination base={base} current={current} total={total} />
    </ListSearch>
  </div>
</section>

<style>
  .filter-chip.is-active {
    background: var(--color-primary);
    color: var(--color-primary-content);
    border-color: var(--color-primary);
  }
  .filter-chip:not(.is-active):hover {
    border-color: color-mix(in oklch, var(--color-base-content) 30%, transparent);
  }
</style>
