---
/**
 * <SystemIcon /> — inline SVG icon that inherits the current text colour.
 * Resolves through src/icons/index.ts: your own override, then lucide-static.
 *
 *   <SystemIcon name="briefcase" />
 *   <SystemIcon name="github" size={18} class="text-primary" />
 *   <SystemIcon name="clock" title="Reading time" />   // adds an accessible label
 *
 * Pass `title` when the icon conveys meaning on its own; otherwise it's
 * marked decorative (aria-hidden). For a resolved tech/tool logo, use
 * <TechIcon /> instead (see src/components/TechIcon.astro).
 */
import { resolveSystemIcon } from "../icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  title?: string;
  fill?: string;
  stroke?: string;
}

// Defaults
const {
  name,
  size = 20,
  class: cls = "",
  strokeWidth = 2,
  title,
  fill = "none",
  stroke = "currentColor"
} = Astro.props;

const body = resolveSystemIcon(name);
if (!body) {
  // Fail loudly in dev, render nothing in prod, rather than a broken glyph.
  console.warn(`[SystemIcon] unknown icon "${name}"`);
}
const inner = (title ? `<title>${title}</title>` : "") + (body ?? "");
---

{
  body && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={fill}
      stroke={stroke}
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={["icon", cls]}
      role={title ? "img" : undefined}
      aria-label={title ?? undefined}
      aria-hidden={title ? undefined : "true"}
      set:html={inner}
    />
  )
}
