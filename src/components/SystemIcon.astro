---
/** Inline SVG icon resolved through src/icons/index.ts. Pass `title` if the icon carries meaning, otherwise it is aria-hidden. */
import { resolveSystemIcon } from "../icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  title?: string;
  fill?: string;
  stroke?: string;
}

const {
  name,
  size = 20,
  class: cls = "",
  strokeWidth = 2,
  title,
  fill = "none",
  stroke = "currentColor"
} = Astro.props;

const body = resolveSystemIcon(name);
if (!body) {
  console.warn(`[SystemIcon] unknown icon "${name}"`);
}
const inner = (title ? `<title>${title}</title>` : "") + (body ?? "");
---

{
  body && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={fill}
      stroke={stroke}
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={["icon", cls]}
      role={title ? "img" : undefined}
      aria-label={title ?? undefined}
      aria-hidden={title ? undefined : "true"}
      set:html={inner}
    />
  )
}
