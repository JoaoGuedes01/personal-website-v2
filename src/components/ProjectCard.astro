---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { href } from "../data/site";
import SystemIcon from "./SystemIcon.astro";
import TechBadge from "./TechBadge.astro";
import { projectTypeIcon } from "../icons";
import { projectCover } from "../utils/covers";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { title, summary, type, org, orgUrl, category, stack, year, repo, demo, video } = entry.data;
const url = href(`/projects/${entry.id}`);

// Cover auto-detection
const cover = projectCover(entry.id);

// Keep the card balanced: show the first few technologies (authored order) and
// fold the rest into a "+N more" hint — the full stack lives on the detail page.
const CARD_STACK_LIMIT = 6;
const shownStack = stack.slice(0, CARD_STACK_LIMIT);
const moreCount = stack.length - shownStack.length;
---

<article
  class="card-lift group relative flex h-full flex-col overflow-hidden rounded-box border border-base-300 bg-base-100 p-6"
>
  {
    cover && (
      <div class="-mx-6 -mt-6 mb-5 overflow-hidden border-b border-base-300 bg-base-200">
        <Image
          src={cover}
          alt={`${title} — cover`}
          width={800}
          class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="mb-3 flex items-center justify-between gap-2">
    <p class="eyebrow flex items-center gap-1.5">
      <SystemIcon name={projectTypeIcon[type]} size={13} />
      <span>{type}</span>
      {
        org && (
          <>
            <span class="text-base-content/30">·</span>
            {orgUrl ? (
              <a
                href={orgUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="relative z-10 text-primary hover:underline"
              >
                {org}
              </a>
            ) : (
              <span>{org}</span>
            )}
          </>
        )
      }
    </p>
    {year && <span class="text-xs text-base-content/40">{year}</span>}
  </div>

  <h3 class="font-display text-xl leading-snug">
    <a href={url} class="after:absolute after:inset-0 group-hover:text-primary">{title}</a>
  </h3>

  <p class="mt-2 text-sm leading-relaxed text-base-content/70">{summary}</p>

  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    <span class="rounded-full bg-base-200 px-2.5 py-0.5 text-[11px] text-base-content/60">{category}</span>
    {shownStack.map((s) => <TechBadge tech={s} />)}
    {
      moreCount > 0 && (
        <span class="rounded-full px-2 py-0.5 text-[11px] text-base-content/45">+{moreCount} more</span>
      )
    }
  </div>

  {
    (repo || demo || video) && (
      <div class="relative z-10 mt-4 flex flex-wrap gap-4 text-xs">
        {repo && (
          <a href={repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-base-content/55 underline-offset-4 hover:text-primary hover:underline">
            Repository <SystemIcon name="arrow-up-right" size={12} />
          </a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-base-content/55 underline-offset-4 hover:text-primary hover:underline">
            Live demo <SystemIcon name="arrow-up-right" size={12} />
          </a>
        )}
        {video && (
          <a href={video} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-base-content/55 underline-offset-4 hover:text-primary hover:underline">
            <SystemIcon name="circle-play" size={12} /> Video
          </a>
        )}
      </div>
    )
  }
</article>
