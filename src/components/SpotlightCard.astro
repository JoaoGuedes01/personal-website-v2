---
/**
 * <SpotlightCard /> — the "Featured" card. Deliberately unlike the list cards:
 * the cover is the whole card, with the text set on a dark gradient over it
 * (magazine-cover style). No cover → the topic-tinted gradient fills the card.
 */
import { Image } from "astro:assets";
import { slugify } from "../data/taxonomy";
import { tileGradient } from "../utils/tile";

interface Props {
  url: string;
  title: string;
  description: string;
  date: Date;
  readingTime?: string;
  tags?: string[];
  tagBase?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  large?: boolean; // the lead card: taller, bigger title
}
const { url, title, description, date, readingTime, tags = [], tagBase, cover, coverAlt = "", large = false } = Astro.props;
const dateStr = date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<article
  class:list={[
    "card-lift group relative isolate flex flex-col justify-end overflow-hidden rounded-box border border-base-300 text-white",
    large ? "min-h-[20rem] sm:min-h-[23rem]" : "min-h-[16rem]",
  ]}
  style={!cover ? `background:${tileGradient(tags[0] ?? title)}` : undefined}
>
  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt}
        class="absolute inset-0 -z-10 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.04]"
        loading={large ? "eager" : "lazy"}
      />
    )
  }
  <!-- Scrim: a flat dim over the whole image plus a strong gradient under the text,
       so white type stays readable on bright or busy covers. -->
  <div class="absolute inset-0 -z-10 bg-black/25"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/90 via-black/65 to-transparent"></div>

  <div class:list={["flex flex-col", large ? "p-6 sm:p-9" : "p-6"]}>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-primary px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-primary-content">Featured</span>
      <span class="inline-flex items-center gap-2 rounded-full bg-black/55 px-2.5 py-1 text-white backdrop-blur-sm">
        <time datetime={date.toISOString()}>{dateStr}</time>
        {readingTime && <><span class="text-white/50">·</span><span>{readingTime}</span></>}
      </span>
    </div>

    <h3 class:list={["mt-3 font-display leading-tight text-white [text-shadow:0_2px_10px_rgb(0_0_0/0.55)]", large ? "max-w-2xl text-3xl sm:text-4xl" : "text-2xl"]}>
      <a href={url} class="after:absolute after:inset-0">{title}</a>
    </h3>

    <p class:list={["mt-2 max-w-2xl text-white/90 [text-shadow:0_1px_4px_rgb(0_0_0/0.6)]", large ? "line-clamp-3 text-base sm:text-lg" : "line-clamp-2 text-sm"]}>{description}</p>

    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((t) => (
            <li>
              {tagBase ? (
                <a
                  href={`${tagBase}?tag=${slugify(t)}`}
                  class="relative z-10 inline-block rounded-full border border-white/40 bg-black/30 px-2.5 py-0.5 text-[11px] text-white backdrop-blur-sm transition-colors hover:bg-white/25"
                >
                  {t}
                </a>
              ) : (
                <span class="inline-block rounded-full border border-white/40 bg-black/30 px-2.5 py-0.5 text-[11px] text-white">{t}</span>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
