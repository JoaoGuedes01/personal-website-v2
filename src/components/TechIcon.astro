---
/**
 * <TechIcon /> — bare icon for one technology, resolved via resolveTech()
 * (src/data/tech.ts): your own SVG override, then a simple-icons logo, then
 * a generic group-icon fallback. No label — for a labelled chip, see
 * <TechBadge />, which renders this plus the tech's name.
 *
 *   <TechIcon tech="React" />
 *   <TechIcon tech={resolved} size={16} />
 */
import { resolveTech, type ResolvedTech } from "../data/tech";

interface Props {
  tech: string | ResolvedTech;
  size?: number;
  class?: string;
}

const { tech, size = 12, class: cls = "" } = Astro.props;
const t: ResolvedTech = typeof tech === "string" ? resolveTech(tech) : tech;
const stroke = t.icon.mode === "stroke";
---

{
  t.icon.svg && (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill={stroke ? "none" : "currentColor"}
      stroke={stroke ? "currentColor" : "none"}
      stroke-width={stroke ? 2 : undefined}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class:list={["shrink-0 opacity-80", cls]}
      set:html={t.icon.svg}
    />
  )
}
