---
// Swap the portrait by overwriting public/guedes-vector.svg.
import { href as resolveHref } from "../data/site";

interface Props {
  class?: string;
  eager?: boolean;
  href?: string;
}

const { class: className = "", eager = false, href } = Astro.props;
---

<img
  src={href || resolveHref("/guedes-vector.svg")}
  alt="Illustrated portrait of João Guedes"
  width="544"
  height="560"
  class:list={["block h-auto w-full select-none", className]}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  draggable="false"
/>
