---
/** Thumbnail grid with a lightbox, for project page screenshots. */
import { Image, getImage } from "astro:assets";

interface GalleryImage {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
}
interface Props {
  images: GalleryImage[];
}
const { images } = Astro.props;

// Full-size versions for the lightbox, passed to the client script.
const full = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: 1600, format: "webp" })),
);
const slides = images.map((img, i) => ({
  src: full[i].src,
  alt: img.alt ?? "",
  caption: img.caption ?? "",
}));
---

<div class="not-prose">
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
    {
      images.map((img, i) => (
        <li>
          <button
            type="button"
            class="gallery-thumb group block w-full overflow-hidden rounded-xl border border-base-300 bg-base-200"
            data-index={i}
            aria-label={`Open image ${i + 1}${img.alt ? `: ${img.alt}` : ""}`}
          >
            <Image
              src={img.src}
              alt={img.alt ?? ""}
              width={800}
              class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
              loading="lazy"
            />
          </button>
        </li>
      ))
    }
  </ul>

  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
  >
    <button id="lb-close" type="button" class="absolute right-4 top-4 rounded-full p-2 text-white/80 transition-colors hover:bg-white/10 hover:text-white" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    <button id="lb-prev" type="button" class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full p-2 text-white/80 transition-colors hover:bg-white/10 hover:text-white sm:left-6" aria-label="Previous image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button id="lb-next" type="button" class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full p-2 text-white/80 transition-colors hover:bg-white/10 hover:text-white sm:right-6" aria-label="Next image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>

    <figure class="flex max-h-full max-w-5xl flex-col items-center gap-3">
      <img id="lb-img" src="" alt="" class="max-h-[80vh] w-auto rounded-lg object-contain" />
      <figcaption id="lb-cap" class="text-center text-sm text-white/70"></figcaption>
      <span id="lb-count" class="text-xs text-white/40"></span>
    </figure>
  </div>
</div>

<script define:vars={{ slides }}>
  (function () {
    const lb = document.getElementById("lightbox");
    if (!lb || !slides.length) return;
    const imgEl = document.getElementById("lb-img");
    const capEl = document.getElementById("lb-cap");
    const countEl = document.getElementById("lb-count");
    const thumbs = Array.from(document.querySelectorAll(".gallery-thumb"));
    let idx = 0;

    function render() {
      const s = slides[idx];
      imgEl.src = s.src;
      imgEl.alt = s.alt;
      capEl.textContent = s.caption || "";
      capEl.style.display = s.caption ? "" : "none";
      countEl.textContent = slides.length > 1 ? `${idx + 1} / ${slides.length}` : "";
    }
    function open(i) {
      idx = i;
      render();
      lb.classList.remove("hidden");
      lb.classList.add("flex");
      document.body.style.overflow = "hidden";
      document.getElementById("lb-close")?.focus();
    }
    function close() {
      lb.classList.add("hidden");
      lb.classList.remove("flex");
      document.body.style.overflow = "";
    }
    const next = () => { idx = (idx + 1) % slides.length; render(); };
    const prev = () => { idx = (idx - 1 + slides.length) % slides.length; render(); };

    thumbs.forEach((t) =>
      t.addEventListener("click", () => open(Number(t.getAttribute("data-index")) || 0)),
    );
    document.getElementById("lb-close")?.addEventListener("click", close);
    document.getElementById("lb-next")?.addEventListener("click", next);
    document.getElementById("lb-prev")?.addEventListener("click", prev);
    lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
    document.addEventListener("keydown", (e) => {
      if (lb.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") next();
      else if (e.key === "ArrowLeft") prev();
    });
  })();
</script>
