---
import { site, socials, nav, href } from "../data/site";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-base-300 bg-base-200/30">
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-lg font-semibold">{site.name}</p>
        <p class="mt-1 text-sm text-base-content/60">{site.role} · Braga, Portugal</p>
        <p class="mt-3 text-sm leading-relaxed text-base-content/55">
          Built with Astro and DaisyUI. Thanks for stopping by.
        </p>
        <p class="mt-5 text-xs leading-relaxed text-base-content/30">100% Human made</p>
      </div>

      <div class="flex gap-12">
        <nav aria-label="Footer">
          <p class="eyebrow mb-3">Site</p>
          <ul class="space-y-2">
            {
              nav.slice(0, 5).map((item) => (
                <li>
                  <a href={href(item.path)} class="text-sm text-base-content/65 transition-colors hover:text-primary">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <p class="eyebrow mb-3">Reach me</p>
          <ul class="space-y-2">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex items-center gap-2 text-sm text-base-content/65 transition-colors hover:text-primary"
                    {...(s.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    <Icon name={s.icon} size={15} class="text-base-content/50", stroke={s.stroke}, fill={s.fill} />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-base-300/60 pt-6 text-xs text-base-content/45">
      © {year} {site.name}
    </div>
  </div>
</footer>
