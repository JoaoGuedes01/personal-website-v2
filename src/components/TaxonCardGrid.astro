---
/**
 * <TaxonCardGrid /> — a grid of drill-down cards (icon, label, blurb, count)
 * linking into a taxon (category/group/subgroup). Shared by the /snippets
 * landing page, a category page listing its groups, and a group page listing
 * its subgroups — same look at every level.
 *
 * Layout: icon tile on top, then title + blurb, then a quiet footer row with
 * the count on the left and an arrow on the right. The footer is pinned to the
 * bottom so cards in a row line up regardless of blurb length.
 */
import SystemIcon from "./SystemIcon.astro";

export interface TaxonCard {
  href: string;
  icon: string;
  label: string;
  blurb: string;
  count: number;
  noun?: string; // singular noun for the count, default "snippet"
}
interface Props {
  cards: TaxonCard[];
}
const { cards } = Astro.props;
// 3 (or 5+) cards read best in three columns; 1, 2 or 4 pair up in two.
const threeUp = cards.length === 3 || cards.length > 4;
---

<div class:list={["grid gap-4 sm:grid-cols-2", threeUp && "lg:grid-cols-3"]}>
  {
    cards.map((c) => (
      <a
        href={c.href}
        class="card-lift group flex flex-col rounded-box border border-base-300 bg-base-100 p-5 hover:border-primary/40"
      >
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-field bg-primary/10 text-primary transition-colors duration-200 group-hover:bg-primary group-hover:text-primary-content">
          <SystemIcon name={c.icon} size={20} />
        </span>

        <h2 class="mt-4 font-display text-lg leading-snug">{c.label}</h2>
        <p class="mb-5 mt-1.5 line-clamp-3 text-sm leading-relaxed text-base-content/68">{c.blurb}</p>

        <span class="mt-auto flex items-center justify-between border-t border-base-300/70 pt-3 text-xs text-base-content/64">
          <span class="tabular-nums">
            {c.count} {c.count === 1 ? (c.noun ?? "snippet") : `${c.noun ?? "snippet"}s`}
          </span>
          <SystemIcon
            name="arrow-right"
            size={16}
            class="-translate-x-1 text-base-content/30 transition-all duration-200 group-hover:translate-x-0 group-hover:text-primary"
          />
        </span>
      </a>
    ))
  }
</div>
