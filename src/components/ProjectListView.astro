---
/**
 * Projects listing. Filtering is the shared <FilterBar />: Type and Category are
 * dropdown facets that stack with the search box, all client-side, hiding/showing
 * the real cards in place. Every non-draft project is rendered (no pagination) so
 * the filters can span the whole set; without JS the full grid still shows.
 */
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import FilterBar from "./FilterBar.astro";
import type { Facet } from "./FilterBar.astro";
import {
  PROJECT_TYPES,
  PROJECT_CATEGORIES,
  projectTypeByLabel,
  projectCategorySlug,
} from "../data/taxonomy";
import { collectTech, resolveTech } from "../data/tech";
import { PAGE_SIZE } from "../utils/paginate";

interface Props {
  items: CollectionEntry<"projects">[]; // all non-draft projects
  eyebrow: string;
  title: string;
  intro: string;
}
const { items, eyebrow, title, intro } = Astro.props;

// Facets — only values actually present, counts scoped to the set, taxonomy order.
const facets: Facet[] = [
  {
    key: "type",
    label: "Type",
    icon: "layers",
    options: PROJECT_TYPES.map((t) => ({
      value: t.slug,
      label: t.label,
      icon: t.icon,
      count: items.filter((p) => p.data.type === t.label).length,
    })).filter((o) => o.count > 0),
  },
  {
    key: "category",
    label: "Category",
    icon: "folder",
    options: PROJECT_CATEGORIES.map((c) => ({
      value: c.slug,
      label: c.label,
      icon: c.icon,
      count: items.filter((p) => p.data.category === c.label).length,
    })).filter((o) => o.count > 0),
  },
  {
    // Every technology used across the set, most-used first. The list is long
    // by design (no cap) so any tech linked from a project page resolves here;
    // the dropdown scrolls and each option shows its live result count.
    key: "stack",
    label: "Stack",
    icon: "cpu",
    options: collectTech(items.map((p) => p.data.stack)).map((t) => ({
      value: t.id,
      label: t.label,
      count: t.count,
    })),
  },
];

// Per-card metadata the FilterBar matches against (one data-<facet.key> each).
const cards = items.map((entry) => ({
  entry,
  type: projectTypeByLabel(entry.data.type)?.slug ?? "",
  category: projectCategorySlug(entry.data.category),
  stack: [...new Set(entry.data.stack.map((s) => resolveTech(s).id))].join(" "),
  search: [
    entry.data.title,
    entry.data.summary,
    entry.data.type,
    entry.data.org,
    entry.data.category,
    entry.data.year,
    ...entry.data.stack,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase(),
}));
---

<section class="mx-auto max-w-5xl px-4 pt-16 sm:px-6 sm:pt-20">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="mt-4 text-4xl sm:text-5xl">{title}</h1>
  <p class="mt-4 max-w-xl text-lg text-base-content/70">{intro}</p>

  <div class="mt-8">
    <FilterBar
      facets={facets}
      count={items.length}
      noun="project"
      pageSize={PAGE_SIZE}
      searchPlaceholder="Search projects…"
      searchLabel="Search projects"
    >
      <div class="mt-2 grid gap-5 pb-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((c) => (
            <div
              data-filter-item
              data-type={c.type}
              data-category={c.category}
              data-stack={c.stack}
              data-search={c.search}
            >
              <ProjectCard entry={c.entry} />
            </div>
          ))
        }
      </div>
    </FilterBar>
  </div>
</section>
